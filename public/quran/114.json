{"n":114,"verses":[{"v":1,"en":"Say, \"I seek refuge in the Lord of mankind","bn":"বলুন, আমি আশ্রয় গ্রহণ করিতেছি মানুষের পালনকর্তার","w":[["قُلۡ","Say","qul",6,"قُلْ"],["أَعُوذُ","I seek refuge","aʿūdhu",809,"اَعُوْذُ"],["بِرَبِّ","in (the) Lord","birabbi",12,"بِرَبِّ"],["ٱلنَّاسِ","(of) mankind","l-nāsi",50,"النَّاسِ ۟ۙ"]]},{"v":2,"en":"The Sovereign of mankind","bn":"মানুষের অধিপতির","w":[["مَلِكِ","(The) King","maliki",615,"مَلِكِ"],["ٱلنَّاسِ","(of) mankind","l-nāsi",50,"النَّاسِ ۟ۙ"]]},{"v":3,"en":"The God of mankind","bn":"মানুষের মা’বুদের","w":[["إِلَٰهِ","(The) God","ilāhi",78,"اِلٰهِ"],["ٱلنَّاسِ","(of) mankind","l-nāsi",50,"النَّاسِ ۟ۙ"]]},{"v":4,"en":"From the evil of the retreating whisperer","bn":"তার অনিষ্ট থেকে, যে কুমন্ত্রণা দেয় ও আত্নগোপন করে","w":[["مِن","From","min",0,"مِنْ"],["شَرِّ","(the) evil","sharri",359,"شَرِّ"],["ٱلۡوَسۡوَاسِ","(of) the whisperer","l-waswāsi",4780,"الْوَسْوَاسِ ۙ۬"],["ٱلۡخَنَّاسِ","the one who withdraws","l-khanāsi",4781,"الْخَنَّاسِ ۟"]]},{"v":5,"en":"Who whispers [evil] into the breasts of mankind","bn":"যে কুমন্ত্রণা দেয় মানুষের অন্তরে","w":[["ٱلَّذِي","The one who","alladhī",7,"الَّذِیْ"],["يُوَسۡوِسُ","whispers","yuwaswisu",1559,"یُوَسْوِسُ"],["فِي","in","fī",3,"فِیْ"],["صُدُورِ","(the) breasts","ṣudūri",257,"صُدُوْرِ"],["ٱلنَّاسِ","(of) mankind","l-nāsi",50,"النَّاسِ ۟ۙ"]]},{"v":6,"en":"From among the jinn and mankind","bn":"জ্বিনের মধ্য থেকে অথবা মানুষের মধ্য থেকে।","w":[["مِنَ","From","mina",0,"مِنَ"],["ٱلۡجِنَّةِ","the jinn","l-jinati",853,"الْجِنَّةِ"],["وَٱلنَّاسِ","and men","wal-nāsi",50,"وَالنَّاسِ ۟۠"]]}]}