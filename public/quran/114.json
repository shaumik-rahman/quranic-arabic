{"n":114,"verses":[{"v":1,"en":"Say, \"I seek refuge in the Lord of mankind","bn":"বলুন, আমি আশ্রয় গ্রহণ করিতেছি মানুষের পালনকর্তার","w":[["قُلۡ","Say","qul",6],["أَعُوذُ","I seek refuge","aʿūdhu",809],["بِرَبِّ","in (the) Lord","birabbi",12],["ٱلنَّاسِ","(of) mankind","l-nāsi",50]]},{"v":2,"en":"The Sovereign of mankind","bn":"মানুষের অধিপতির","w":[["مَلِكِ","(The) King","maliki",615],["ٱلنَّاسِ","(of) mankind","l-nāsi",50]]},{"v":3,"en":"The God of mankind","bn":"মানুষের মা’বুদের","w":[["إِلَٰهِ","(The) God","ilāhi",78],["ٱلنَّاسِ","(of) mankind","l-nāsi",50]]},{"v":4,"en":"From the evil of the retreating whisperer","bn":"তার অনিষ্ট থেকে, যে কুমন্ত্রণা দেয় ও আত্নগোপন করে","w":[["مِن","From","min",0],["شَرِّ","(the) evil","sharri",359],["ٱلۡوَسۡوَاسِ","(of) the whisperer","l-waswāsi",4780],["ٱلۡخَنَّاسِ","the one who withdraws","l-khanāsi",4781]]},{"v":5,"en":"Who whispers [evil] into the breasts of mankind","bn":"যে কুমন্ত্রণা দেয় মানুষের অন্তরে","w":[["ٱلَّذِي","The one who","alladhī",7],["يُوَسۡوِسُ","whispers","yuwaswisu",1559],["فِي","in","fī",3],["صُدُورِ","(the) breasts","ṣudūri",257],["ٱلنَّاسِ","(of) mankind","l-nāsi",50]]},{"v":6,"en":"From among the jinn and mankind","bn":"জ্বিনের মধ্য থেকে অথবা মানুষের মধ্য থেকে।","w":[["مِنَ","From","mina",0],["ٱلۡجِنَّةِ","the jinn","l-jinati",853],["وَٱلنَّاسِ","and men","wal-nāsi",50]]}]}