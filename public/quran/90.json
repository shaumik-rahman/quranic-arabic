w","adrāka",571,"اَدْرٰىكَ","তোমাকে জানাবে"],["مَا","what","mā",2,"مَا","কি"],["ٱلۡعَقَبَةُ","the steep path (is)","l-ʿaqabatu",2812,"الْعَقَبَةُ ۟ؕ","সেই কষ্টসাধ্য গিরিপথ"]]},{"v":13,"en":"It is the freeing of a slave","bn":"তা হচ্ছে দাসমুক্তি","w":[["فَكُّ","(It is) freeing","fakku",4703,"فَكُّ","মুক্তি"],["رَقَبَةٍ","a neck","raqabatin",880,"رَقَبَةٍ ۟ۙ","দাস"]]},{"v":14,"en":"Or feeding on a day of severe hunger","bn":"অথবা দুর্ভিক্ষের দিনে অন্নদান।","w":[["أَوۡ","Or","aw",40,"اَوْ","অথবা"],["إِطۡعَٰمࣱ","feeding","iṭ'ʿāmun",1835,"اِطْعٰمٌ","খানা খাওয়ানো"],["فِي","in","fī",3,"فِیْ","মধ্যে"],["يَوۡمٖ","a day","yawmin",21,"یَوْمٍ","দিনে"],["ذِي","of","dhī",74,"ذِیْ","এর"],["مَسۡغَبَةٖ","severe hunger","masghabatin",4704,"مَسْغَبَةٍ ۟ۙ","দুর্ভিক্ষ"]]},{"v":15,"en":"An orphan of near relationship","bn":"এতীম আত্বীয়কে","w":[["يَتِيمٗا","An orphan","yatīman",444,"یَّتِیْمًا","ইয়াতীমকে"],["ذَا","of","dhā",74,"ذَا","এর"],["مَقۡرَبَةٍ","near relationship","maqrabatin",4705,"مَقْرَبَةٍ ۟ۙ","নিকট আত্মীয় সম্পর্ক"]]},{"v":16,"en":"Or a needy person in misery","bn":"অথবা ধুলি-ধুসরিত মিসকীনকে","w":[["أَوۡ","Or","aw",40,"اَوْ","অথবা"],["مِسۡكِينٗا","a needy person","mis'kīnan",445,"مِسْكِیْنًا","নিঃস্বকে"],["ذَا","in","dhā",74,"ذَا","মাখা/ যুক্ত"],["مَتۡرَبَةٖ","misery","matrabatin",4706,"مَتْرَبَةٍ ۟ؕ","ধুলি/ দারিদ্র-নিষ্পেষিত"]]},{"v":17,"en":"And then being among those who believed and advised one another to patience and advised one another to compassion","bn":"অতঃপর তাদের অন্তর্ভুক্ত হওয়া, যারা ঈমান আনে এবং পরস্পরকে উপদেশ দেয় সবরের ও উপদেশ দেয় দয়ার।","w":[["ثُمَّ","Then","thumma",33,"ثُمَّ","তদুপরি (এর সাথে)"],["كَانَ","he is","kāna",9,"كَانَ","সে হলো"],["مِنَ","of","mina",0,"مِنَ","শামিলও"],["ٱلَّذِينَ","those who","alladhīna",7,"الَّذِیْنَ","(তাদের মধ্য) যারা"],["ءَامَنُواْ","believe","āmanū",19,"اٰمَنُوْا","ঈমান এনেছে"],["وَتَوَاصَوۡاْ","and enjoin (each other)","watawāṣaw",1432,"وَتَوَاصَوْا","ও তারা পরস্পরকে উপদেশ দিয়েছে"],["بِٱلصَّبۡرِ","to patience","bil-ṣabr