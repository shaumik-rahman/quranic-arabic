m","innī",5,"اِنِّیْ","নিশ্চয়ই আমি"],["لَكُمۡ","to you","lakum",20,"لَكُمْ","তোমাদের জন্যে"],["رَسُولٌ","a Messenger","rasūlun",34,"رَسُوْلٌ","রাসূল"],["أَمِينࣱ","trustworthy","amīnun",660,"اَمِیْنٌ ۟ۙ","বিশ্বস্ত"]]},{"v":19,"en":"And [saying], \"Be not haughty with Allah. Indeed, I have come to you with clear authority","bn":"আর তোমরা আল্লাহর বিরুদ্ধে ঔদ্ধত্য প্রকাশ করো না। আমি তোমাদের কাছে প্রকাশ্য প্রমাণ উপস্থিত করছি।","w":[["وَأَن","And that","wa-an",18,"وَّاَنْ","এবং (এও বলেছিল) যে"],["لَّا","(do) not","lā",4,"لَّا","না"],["تَعۡلُواْ","exalt yourselves","taʿlū",1232,"تَعْلُوْا","বড়াই করো"],["عَلَى","against","ʿalā",8,"عَلَی","উপর"],["ٱللَّهِۖ","Allah","l-lahi",1,"اللّٰهِ ؕ","আল্লাহ্‌র"],["إِنِّيٓ","Indeed, I","innī",5,"اِنِّیْۤ","আমি নিশ্চয়ই"],["ءَاتِيكُم","[I] have come to you","ātīkum",46,"اٰتِیْكُمْ","তোমাদের কাছে এসেছি"],["بِسُلۡطَٰنٖ","with an authority","bisul'ṭānin",312,"بِسُلْطٰنٍ","নিয়ে প্রমাণ"],["مُّبِينٖ","clear","mubīnin",99,"مُّبِیْنٍ ۟ۚ","সুস্পষ্ট"]]},{"v":20,"en":"And indeed, I have sought refuge in my Lord and your Lord, lest you stone me","bn":"তোমরা যাতে আমাকে প্রস্তরবর্ষণে হত্যা না কর, তজ্জন্যে আমি আমার পালনকর্তা ও তোমাদের পালনকর্তার শরনাপন্ন হয়েছি।","w":[["وَإِنِّي","And indeed, I","wa-innī",5,"وَاِنِّیْ","এবং নিশ্চয়ই আমি"],["عُذۡتُ","[I] seek refuge","ʿudh'tu",809,"عُذْتُ","আশ্রয় নিয়েছি"],["بِرَبِّي","with my Lord","birabbī",12,"بِرَبِّیْ","আমার রবের (কাছে)"],["وَرَبِّكُمۡ","and your Lord","warabbikum",12,"وَرَبِّكُمْ","এবং তোমাদের (প্রকৃত রবের)"],["أَن","lest","an",18,"اَنْ","(এ হ'তে) যে"],["تَرۡجُمُونِ","you stone me","tarjumūni",1389,"تَرْجُمُوْنِ ۟ؗ","আমাকে তোমরা পাথর মেরে হত্যা করবে"]]},{"v":21,"en":"But if you do not believe me, then leave me alone","bn":"তোমরা যদি আমার প্রতি বিশ্বাস স্থাপন না কর, তবে আমার কাছ থেকে দূরে থাক।","w":[["وَإِن","And if","wa-in",16,"وَاِنْ","আর যদি"],["لَّمۡ","not","lam",31,"لَّمْ","না"],["تُؤۡمِنُواْ","you believe","tu'minū",19,"تُؤْمِنُوْا","তোমরা ঈমান আনো"],["لِي","me","lī",79,"لِیْ","আমার উ