ে"],["مَا","what","mā",2,"مَا","কি (সেই)"],["يَوۡمُ","(is the) Day","yawmu",21,"یَوْمُ","দিন"],["ٱلدِّينِ","(of) the Judgment","l-dīni",115,"الدِّیْنِ ۟ۙ","বিচারের"]]},{"v":18,"en":"Then, what can make you know what is the Day of Recompense","bn":"অতঃপর আপনি জানেন, বিচার দিবস কি","w":[["ثُمَّ","Then","thumma",33,"ثُمَّ","অতঃপর"],["مَآ","what","mā",2,"مَاۤ","কিসে"],["أَدۡرَىٰكَ","can make you know","adrāka",571,"اَدْرٰىكَ","তোমাকে জানাবে"],["مَا","what","mā",2,"مَا","কি সেই"],["يَوۡمُ","(is the) Day","yawmu",21,"یَوْمُ","দিন"],["ٱلدِّينِ","(of) the Judgment","l-dīni",115,"الدِّیْنِ ۟ؕ","বিচারের"]]},{"v":19,"en":"It is the Day when a soul will not possess for another soul [power to do] a thing; and the command, that Day, is [entirely] with Allah","bn":"যেদিন কেউ কারও কোন উপকার করতে পারবে না এবং সেদিন সব কতৃꦣ2468;্ব হবে আল্লাহর।","w":[["يَوۡمَ","(The) Day","yawma",21,"یَوْمَ","সেদিন"],["لَا","not","lā",4,"لَا","না"],["تَمۡلِكُ","will have power","tamliku",259,"تَمْلِكُ","সক্ষম হবে"],["نَفۡسࣱ","a soul","nafsun",37,"نَفْسٌ","কেউ"],["لِّنَفۡسٖ","for a soul","linafsin",37,"لِّنَفْسٍ","কারও জন্যে"],["شَيۡـٔٗاۖ","anything","shayan",39,"شَیْـًٔا ؕ","কিছু (করতে)"],["وَٱلۡأَمۡرُ","and the Command","wal-amru",67,"وَالْاَمْرُ","এবং কর্তৃত্ব"],["يَوۡمَئِذٖ","that Day","yawma-idhin",21,"یَوْمَىِٕذٍ","সেদিন (হবে কেবল)"],["لِّلَّهِ","(will be) with Allah","lillahi",1,"لِّلّٰهِ ۟۠","আল্লাহর জন্যে"]]}]}