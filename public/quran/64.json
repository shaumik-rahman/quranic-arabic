"هُوَ ؕ","তিনি"],["وَعَلَى","And upon","waʿalā",8,"وَعَلَی","এবং উপর"],["ٱللَّهِ","Allah","l-lahi",1,"اللّٰهِ","আল্লাহ্‌র"],["فَلۡيَتَوَكَّلِ","let put (their) trust","falyatawakkali",287,"فَلْیَتَوَكَّلِ","সুতরাং ভরসা করুক"],["ٱلۡمُؤۡمِنُونَ","the believers","l-mu'minūna",54,"الْمُؤْمِنُوْنَ ۟","মু'মিনগণ"]]},{"v":14,"en":"O you who have believed, indeed, among your wives and your children are enemies to you, so beware of them. But if you pardon and overlook and forgive - then indeed, Allah is Forgiving and Merciful","bn":"হে মুমিনগণ, তোমাদের কোন কোন স্ত্রী ও সন্তান-সন্ততি তোমাদের দুশমন। অতএব তাদের ব্যাপারে সতর্ক থাক। যদি মার্জনা কর, উপেক্ষা কর, এবং ক্ষমা কর, তবে আল্লাহ ক্ষমাশীল, করুনাময়।","w":[["يَـٰٓأَيُّهَا","O","yāayyuhā",53,"یٰۤاَیُّهَا","ওহে"],["ٱلَّذِينَ","(you) who","alladhīna",7,"الَّذِیْنَ","যারা"],["ءَامَنُوٓاْ","believe","āmanū",19,"اٰمَنُوْۤا","ঈমান এনেছো"],["إِنَّ","Indeed","inna",5,"اِنَّ","নিশ্চয়"],["مِنۡ","from","min",0,"مِنْ","মধ্যে"],["أَزۡوَٰجِكُمۡ","your spouses","azwājikum",143,"اَزْوَاجِكُمْ","তোমাদের স্ত্রীদের"],["وَأَوۡلَٰدِكُمۡ","and your children","wa-awlādikum",206,"وَاَوْلَادِكُمْ","ও তোমাদের সন্তান সন্ততিদের (কেউ কেউ)"],["عَدُوّٗا","(are) enemies","ʿaduwwan",227,"عَدُوًّا","শত্রু"],["لَّكُمۡ","to you","lakum",20,"لَّكُمْ","তোমাদের জন্যে"],["فَٱحۡذَرُوهُمۡۚ","so beware of them","fa-iḥ'dharūhum",713,"فَاحْذَرُوْهُمْ ۚ","অতএব তাদের থেকে সতর্ক হও"],["وَإِن","But if","wa-in",16,"وَاِنْ","এবং যদি"],["تَعۡفُواْ","you pardon","taʿfū",388,"تَعْفُوْا","তোমরা মার্জনা কর"],["وَتَصۡفَحُواْ","and overlook","wataṣfaḥū",1133,"وَتَصْفَحُوْا","ও তোমরা উপেক্ষা কর"],["وَتَغۡفِرُواْ","and forgive","wataghfirū",174,"وَتَغْفِرُوْا","এবং তোমরা মাফ কর"],["فَإِنَّ","then indeed","fa-inna",5,"فَاِنَّ","তবে নিশ্চয়"],["ٱللَّهَ","Allah","l-laha",1,"اللّٰهَ","আল্লাহ্‌"],["غَفُورࣱ","(is) Oft-Forgiving","ghafūrun",117,"غَفُوْرٌ","ক্ষমাশীল"],["رَّحِيمٌ","Most Merciful","raḥīmun",100,"رَّحِیْمٌ ۟","মেহেরবান"]]},{"v":15,"en":"Your wealth and your children are but a trial, and Allah has with Him a great reward","bn":"তোমাদের ধন-সম্পদ ও সন্তান-সন্ততি তো কেবল পরীক্ষাস্বরূপ। আর আল্লাহর কাছে রয়েছে মহাপুরস্কার।","w":[["إِنَّمَآ","Only","innamā",5,"اِنَّمَاۤ","মূলতঃ"],["أَمۡوَٰلُكُمۡ","your wealth","amwālukum",125,"اَمْوَالُكُمْ","তোমাদের মালগুলো"],["وَأَوۡلَٰدُكُمۡ","and your children","wa-awlādukum",206,"وَاَوْلَادُكُمْ","ও তোমাদের সন্তান সন্ততিরা"],["فِتۡنَةࣱۚ","(are) a trial","fit'natun",328,"فِتْنَةٌ ؕ","পরীক্ষা"],["وَٱللَّهُ","and Allah","wal-lahu",1,"وَاللّٰهُ","এবং আল্লাহ্‌"],["عِندَهُۥٓ","with Him","ʿindahu",57,"عِنْدَهٗۤ","তাঁর কাছে (আছে)"],["أَجۡرٌ","(is) a reward","ajrun",108,"اَجْرٌ","প্রতিফল"],["عَظِيمࣱ","great","ʿaẓīmun",104,"عَظِیْمٌ ۟","বড়"]]},{"v":16,"en":"So fear Allah as much as you are able and listen and obey and spend [in the way of Allah]; it is better for your selves. And whoever is protected from the stinginess of his soul - it is those who will be the successful","bn":"অতএব তোমরা যথাসাধ্য আল্লাহকে ভয় কর, শুন, আনুগত্য কর এবং ব্যয় কর। এটা তোমাদের জন্যে কল্যাণকর। যারা মনের কার্পন্য থেকে মুক্ত, তারাই সফলকাম।","w":[["فَٱتَّقُواْ","So fear","fa-ittaqū",66,"فَاتَّقُوا","অতএব তোমরা ভয় করো"],["ٱللَّهَ","Allah","l-laha",1,"اللّٰهَ","আল্লাহকে"],["مَا","what","mā",2,"مَا","যতটা"],["ٱسۡتَطَعۡتُمۡ","you are able","is'taṭaʿtum",267,"اسْتَطَعْتُمْ","তোমরা পারো"],["وَٱسۡمَعُواْ","and listen","wa-is'maʿū",140,"وَاسْمَعُوْا","ও তোমরা শুনো"],["وَأَطِيعُواْ","and obey","wa-aṭīʿū",159,"وَاَطِیْعُوْا","ও তোমরা আনুগত্য করো"],["وَأَنفِقُواْ","and spend","wa-anfiqū",172,"وَاَنْفِقُوْا","তোমরা খরচ করো"],["خَيۡرٗا","(it is) better","khayran",61,"خَیْرًا","উত্তম"],["لِّأَنفُسِكُمۡۗ","for yourselves","li-anfusikum",37,"لِّاَنْفُسِكُمْ ؕ","তোমাদের নিজেদের জন্যে"],["وَمَن","And whoever","waman",14,"وَمَنْ","এবং যে"],["يُوقَ","is saved","yūqa",583,"یُّوْقَ","রক্ষা পেল"],["شُحَّ","(from the) greediness","shuḥḥa",1329,"شُحَّ","সংকীর্ণতা (থেকে)"],["نَفۡسِهِۦ","(of) his soul","nafsihi",37,"نَفْسِهٖ","তার মনের"],["فَأُوْلَـٰٓئِكَ","then those","fa-ulāika",11,"فَاُولٰٓىِٕكَ","তবে ঐসব লোক"],["هُمُ","[they]","humu",13,"هُمُ","তারাই"],["ٱلۡمُفۡلِحُونَ","(are) the successful ones","l-muf'liḥūna",662,"الْمُفْلِحُوْنَ ۟","সফলকাম"]]},{"v":17,"en":"If you loan Allah a goodly loan, He will multiply it for you and forgive you. And Allah is Most Appreciative and Forbearing","bn":"যদি তোমরা আল্লাহকে উত্তম ঋণ দান কর, তিনি তোমাদের জন্যে তা দ্বিগুণ করে দেবেন এবং তোমাদেরকে ক্ষমা করবেন। আল্লাহ গুণগ্রাহী, সহনশীল।","w":[["إِن","If","in",16,"اِنْ","যদি"],["تُقۡرِضُواْ","you loan","tuq'riḍū",1148,"تُقْرِضُوا","তোমরা কর্জ দাও"],["ٱللَّهَ","(to) Allah","l-laha",1,"اللّٰهَ","আল্লাহকে"],["قَرۡضًا","a loan","qarḍan",1149,"قَرْضًا","কর্জ"],["حَسَنٗا","goodly","ḥasanan",482,"حَسَنًا","উত্তম"],["يُضَٰعِفۡهُ","He will multiply it","yuḍāʿif'hu",891,"یُّضٰعِفْهُ","তা বহু গুণ করবেন"],["لَكُمۡ","for you","lakum",20,"لَكُمْ","তোমাদের জন্যে"],["وَيَغۡفِرۡ","and will forgive","wayaghfir",174,"وَیَغْفِرْ","ও মাফ করবেন"],["لَكُمۡۚ","you","lakum",20,"لَكُمْ ؕ","তোমাদেরকে"],["وَٱللَّهُ","And Allah","wal-lahu",1,"وَاللّٰهُ","এবং আল্লাহ্‌"],["شَكُورٌ","(is) Most Appreciative","shakūrun",857,"شَكُوْرٌ","গুণগ্রাহী"],["حَلِيمٌ","Most Forbearing","ḥalīmun",613,"حَلِیْمٌ ۟ۙ","ধৈর্যশীল"]]},{"v":18,"en":"Knower of the unseen and the witnessed, the Exalted in Might, the Wise","bn":"তিনি দৃশ্য ও অদৃশ্যের জ্ঞানী, পরাক্রান্ত, প্রজ্ঞাময়।","w":[["عَٰلِمُ","(The) Knower","ʿālimu",543,"عٰلِمُ","পরিজ্ঞাতা"],["ٱلۡغَيۡبِ","(of) the unseen","l-ghaybi",232,"الْغَیْبِ","অদৃশ্যের"],["وَٱلشَّهَٰدَةِ","and the witnessed","wal-shahādati",406,"وَالشَّهَادَةِ","ও দৃশ্যের"],["ٱلۡعَزِيزُ","the All-Mighty","l-ʿazīzu",110,"الْعَزِیْزُ","মহাপরাক্রমশালী"],["ٱلۡحَكِيمُ","the All-Wise","l-ḥakīmu",112,"الْحَكِیْمُ ۟۠","প্রজ্ঞাময়"]]}]}