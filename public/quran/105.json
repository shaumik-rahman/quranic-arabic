{"n":105,"verses":[{"v":1,"en":"Have you not considered, [O Muhammad], how your Lord dealt with the companions of the elephant","bn":"আপনি কি দেখেননি আপনার পালনকর্তা হস্তীবাহিনীর সাথে কিরূপ ব্যবহার করেছেন","w":[["أَلَمۡ","Have not","alam",31,"اَلَمْ","নাই কি"],["تَرَ","you seen","tara",44,"تَرَ","তুমি দেখো"],["كَيۡفَ","how","kayfa",131,"كَیْفَ","কেমন"],["فَعَلَ","dealt","faʿala",121,"فَعَلَ","করেছেন"],["رَبُّكَ","your Lord","rabbuka",12,"رَبُّكَ","তোমার রব"],["بِأَصۡحَٰبِ","with (the) Companions","bi-aṣḥābi",138,"بِاَصْحٰبِ","বাহিনীর সাথে"],["ٱلۡفِيلِ","(of the) Elephant","l-fīli",4757,"الْفِیْلِ ۟ؕ","হাতি"]]},{"v":2,"en":"Did He not make their plan into misguidance","bn":"তিনি কি তাদের চক্রান্ত নস্যাৎ করে দেননি","w":[["أَلَمۡ","Did not","alam",31,"اَلَمْ","নাই কি"],["يَجۡعَلۡ","He make","yajʿal",32,"یَجْعَلْ","তিনি পরণত করে"],["كَيۡدَهُمۡ","their plan","kaydahum",411,"كَیْدَهُمْ","তাদের ষড়যন্ত্রকে"],["فِي","go","fī",3,"فِیْ","মধ্যে"],["تَضۡلِيلٖ","astray","taḍlīlin",4758,"تَضْلِیْلٍ ۟ۙ","নিষ্ফলতার"]]},{"v":3,"en":"And He sent against them birds in flocks","bn":"তিনি তাদের উপর প্রেরণ করেছেন ঝাঁকে ঝাঁকে পাখী","w":[["وَأَرۡسَلَ","And He sent","wa-arsala",90,"وَّاَرْسَلَ","এবং পাঠিয়েছেন"],["عَلَيۡهِمۡ","against them","ʿalayhim",8,"عَلَیْهِمْ","তাদের বিরুদ্ধে"],["طَيۡرًا","birds","ṭayran",515,"طَیْرًا","পাখি"],["أَبَابِيلَ","(in) flocks","abābīla",4759,"اَبَابِیْلَ ۟ۙ","ঝাঁকে ঝাঁকে"]]},{"v":4,"en":"Striking them with stones of hard clay","bn":"যারা তাদের উপর পাথরের কংকর নিক্ষেপ করছিল।","w":[["تَرۡمِيهِم","Striking them","tarmīhim",908,"تَرْمِیْهِمْ","তাদের উপর নিক্ষেপ করে"],["بِحِجَارَةٖ","with stones","biḥijāratin",800,"بِحِجَارَةٍ","পাথরসমূহকে"],["مِّن","of","min",0,"مِّنْ","হতে"],["سِجِّيلٖ","baked clay","sijjīlin",1933,"سِجِّیْلٍ ۟","কংকরের"]]},{"v":5,"en":"And He made them like eaten straw","bn":"অতঃপর তিনি তাদেরকে ভক্ষিত তৃণসদৃশ করে দেন।","w":[["فَجَعَلَهُمۡ","Then He made them","fajaʿalahum",32,"فَجَعَلَهُمْ","অতঃপর তিনি তাদের করে দেন"],["كَعَصۡفٖ","like straw","kaʿaṣfin",2080,"كَعَصْفٍ","ভুসির মতো"],["مَّأۡكُولِۭ","eaten up","makūlin",4760,"مَّاْكُوْلٍ ۟۠","খাওয়া/ভক্ষিত"]]}]}