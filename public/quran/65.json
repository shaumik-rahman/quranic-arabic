্যয়ভার বহন করবে। যদি তারা তোমাদের সন্তানদেরকে স্তন্যদান করে, তবে তাদেরকে প্রাপ্য পারিশ্রমিক দেবে এবং এ সম্পর্কে পরস্পর সংযতভাবে পরামর্শ করবে। তোমরা যদি পরস্পর জেদ কর, তবে অন্য নারী স্তন্যদান করবে।","w":[["أَسۡكِنُوهُنَّ","Lodge them","askinūhunna",1401,"اَسْكِنُوْهُنَّ","তাদের বাস করতে দাও"],["مِنۡ","from","min",0,"مِنْ","মধ্য হতে"],["حَيۡثُ","where","ḥaythu",347,"حَیْثُ","যেখানে"],["سَكَنتُم","you dwell","sakantum",603,"سَكَنْتُمْ","তোমরা বাস কর"],["مِّن","(out) of","min",0,"مِّنْ","থেকে"],["وُجۡدِكُمۡ","your means","wuj'dikum",4403,"وُّجْدِكُمْ","তোমাদের সামর্থ"],["وَلَا","and (do) not","walā",4,"وَلَا","এবং না"],["تُضَآرُّوهُنَّ","harm them","tuḍārrūhunna",1731,"تُضَآرُّوْهُنَّ","তাদের তোমরা কষ্ট দিও"],["لِتُضَيِّقُواْ","to distress","lituḍayyiqū",4404,"لِتُضَیِّقُوْا","সঙ্কটে ফেলবার জন্যে"],["عَلَيۡهِنَّۚ","[on] them","ʿalayhinna",8,"عَلَیْهِنَّ ؕ","তাদেরকে"],["وَإِن","And if","wa-in",16,"وَاِنْ","এবং যদি"],["كُنَّ","they are","kunna",9,"كُنَّ","তারা হয়"],["أُوْلَٰتِ","those (who are)","ulāti",74,"اُولَاتِ","যারা"],["حَمۡلٖ","pregnant","ḥamlin",1091,"حَمْلٍ","গর্ভবতী"],["فَأَنفِقُواْ","then spend","fa-anfiqū",172,"فَاَنْفِقُوْا","তোমরা খরচ তবে কর"],["عَلَيۡهِنَّ","on them","ʿalayhinna",8,"عَلَیْهِنَّ","তাদের উপর"],["حَتَّىٰ","until","ḥattā",83,"حَتّٰی","যতক্ষণ না"],["يَضَعۡنَ","they deliver","yaḍaʿna",484,"یَضَعْنَ","প্রসব করে"],["حَمۡلَهُنَّۚ","their burden","ḥamlahunna",1091,"حَمْلَهُنَّ ۚ","তাদের গর্ভ"],["فَإِنۡ","Then if","fa-in",16,"فَاِنْ","যদি অতঃপর"],["أَرۡضَعۡنَ","they suckle","arḍaʿna",1318,"اَرْضَعْنَ","তারা দুধপান করায়"],["لَكُمۡ","for you","lakum",20,"لَكُمْ","তোমাদের (বাচ্চাদের)কে"],["فَـَٔاتُوهُنَّ","then give them","faātūhunna",43,"فَاٰتُوْهُنَّ","তাদের দাও তবে তোমরা"],["أُجُورَهُنَّ","their payment","ujūrahunna",108,"اُجُوْرَهُنَّ ۚ","তাদের পারিশ্রমিকাদি"],["وَأۡتَمِرُواْ","and consult","watamirū",2649,"وَاْتَمِرُوْا","ও তোমরা পরামর্শ কর"],["بَيۡنَكُم","among yourselves","baynakum",45,"بَیْنَكُمْ","তোমাদের মাঝে"],["بِمَعۡرُوفٖۖ","with kindne