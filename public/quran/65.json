আয়াতসমূহ পাঠ করেন, যাতে বিশ্বাসী ও সৎকর্মপরায়ণদের অন্ধকার থেকে আলোতে আনয়ন করেন। যে আল্লাহর প্রতি বিশ্বাস স্থাপন করে ও সৎকর্ম সম্পাদন করে, তিনি তাকে দাখিল করবেন জান্নাতে, যার তলদেশে নদী প্রবাহিত, তথায় তারা চিরকাল থাকবে। আল্লাহ তাকে উত্তম রিযিক দেবেন।","w":[["رَّسُولٗا","A Messenger","rasūlan",34,"رَّسُوْلًا","রসূল"],["يَتۡلُواْ","reciting","yatlū",191,"یَّتْلُوْا","পাঠ করেন"],["عَلَيۡكُمۡ","to you","ʿalaykum",8,"عَلَیْكُمْ","তোমাদের নিকট"],["ءَايَٰتِ","(the) Verses","āyāti",28,"اٰیٰتِ","আয়াতগুলো"],["ٱللَّهِ","(of) Allah","l-lahi",1,"اللّٰهِ","আল্লাহর"],["مُبَيِّنَٰتٖ","clear","mubayyinātin",1171,"مُبَیِّنٰتٍ","সুস্পষ্ট"],["لِّيُخۡرِجَ","that he may bring out","liyukh'rija",111,"لِّیُخْرِجَ","বের করার জন্যে"],["ٱلَّذِينَ","those who","alladhīna",7,"الَّذِیْنَ","(তাদের) যারা"],["ءَامَنُواْ","believe","āmanū",19,"اٰمَنُوْا","ঈমান এনেছে"],["وَعَمِلُواْ","and do","waʿamilū",42,"وَعَمِلُوا","ও কাজ করেছে"],["ٱلصَّـٰلِحَٰتِ","righteous deeds","l-ṣāliḥāti",188,"الصّٰلِحٰتِ","নেকীসমূহ"],["مِنَ","from","mina",0,"مِنَ","থেকে"],["ٱلظُّلُمَٰتِ","the darkness[es]","l-ẓulumāti",438,"الظُّلُمٰتِ","অন্ধকারাদি"],["إِلَى","towards","ilā",15,"اِلَی","দিকে"],["ٱلنُّورِۚ","the light","l-nūri",261,"النُّوْرِ ؕ","আলোর"],["وَمَن","And whoever","waman",14,"وَمَنْ","এবং যে"],["يُؤۡمِنۢ","believes","yu'min",19,"یُّؤْمِنْ","ঈমান আনবে"],["بِٱللَّهِ","in Allah","bil-lahi",1,"بِاللّٰهِ","আল্লাহর উপর"],["وَيَعۡمَلۡ","and does","wayaʿmal",42,"وَیَعْمَلْ","ও কাজ করবে"],["صَٰلِحٗا","righteous deeds","ṣāliḥan",153,"صَالِحًا","নেক"],["يُدۡخِلۡهُ","He will admit him","yud'khil'hu",268,"یُّدْخِلْهُ","তাকে প্রবেশ করাবেন তিনি"],["جَنَّـٰتٖ","(into) Gardens","jannātin",77,"جَنّٰتٍ","জান্নাতে"],["تَجۡرِي","flow","tajrī",200,"تَجْرِیْ","প্রবাহিত হয়"],["مِن","from","min",0,"مِنْ","থেকে"],["تَحۡتِهَا","underneath it","taḥtihā",221,"تَحْتِهَا","তারা পাদদেশ"],["ٱلۡأَنۡهَٰرُ","the rivers","l-anhāru",212,"الْاَنْهٰرُ","ঝর্ণাধারাসমূহ"],["خَٰلِدِينَ","abiding","khālidīna",151,"خٰلِدِیْنَ","বসবাসকারী স্থায়ীভাবে"],["فِي