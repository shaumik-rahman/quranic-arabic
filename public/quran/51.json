,"দিকে"],["ٱللَّهِۖ","Allah","l-lahi",1,"اللّٰهِ ؕ","আল্লাহর"],["إِنِّي","indeed, I am","innī",5,"اِنِّیْ","নিশ্চয়ই আমি"],["لَكُم","to you","lakum",20,"لَكُمْ","তোমাদের জন্যে"],["مِّنۡهُ","from Him","min'hu",0,"مِّنْهُ","তার পক্ষ হতে"],["نَذِيرࣱ","a warner","nadhīrun",198,"نَذِیْرٌ","একজন সতর্ককারী"],["مُّبِينࣱ","clear","mubīnun",99,"مُّبِیْنٌ ۟ۚ","সুস্পষ্ট"]]},{"v":51,"en":"And do not make [as equal] with Allah another deity. Indeed, I am to you from Him a clear warner","bn":"তোমরা আল্লাহর সাথে কোন উপাস্য সাব্যস্ত করো না। আমি তাঁর পক্ষ থেকে তোমাদের জন্য সুস্পষ্ট সতর্ককারী।","w":[["وَلَا","And (do) not","walā",4,"وَلَا","এবং না"],["تَجۡعَلُواْ","make","tajʿalū",32,"تَجْعَلُوْا","তোমরা বানাবে"],["مَعَ","with","maʿa",69,"مَعَ","সাথে"],["ٱللَّهِ","Allah","l-lahi",1,"اللّٰهِ","আল্লাহর"],["إِلَٰهًا","god","ilāhan",78,"اِلٰهًا","উপাস্য"],["ءَاخَرَۖ","another","ākhara",168,"اٰخَرَ ؕ","অন্য কোনো"],["إِنِّي","Indeed, I am","innī",5,"اِنِّیْ","নিশ্চয়ই আমি"],["لَكُم","to you","lakum",20,"لَكُمْ","তোমাদের জন্যে"],["مِّنۡهُ","from Him","min'hu",0,"مِّنْهُ","তাঁর পক্ষ হতে"],["نَذِيرࣱ","a warner","nadhīrun",198,"نَذِیْرٌ","একজন সতর্ককারী"],["مُّبِينࣱ","clear","mubīnun",99,"مُّبِیْنٌ ۟","সুস্পষ্ট"]]},{"v":52,"en":"Similarly, there came not to those before them any messenger except that they said, \"A magician or a madman","bn":"এমনিভাবে, তাদের পূর্ববর্তীদের কাছে যখনই কোন রসূল আগমন করেছে, তারা বলছেঃ যাদুকর, না হয় উম্মাদ।","w":[["كَذَٰلِكَ","Likewise","kadhālika",11,"كَذٰلِكَ","এভাবেই"],["مَآ","not","mā",2,"مَاۤ","না"],["أَتَى","came","atā",46,"اَتَی","এসেছে"],["ٱلَّذِينَ","(to) those","alladhīna",7,"الَّذِیْنَ","(তাদের কাছে) যারা"],["مِن","before them","min",0,"مِنْ","থেকে"],["قَبۡلِهِم","before them","qablihim",49,"قَبْلِهِمْ","তাদের পূর্বে (ছিল)"],["مِّن","any","min",0,"مِّنْ","কোনো"],["رَّسُولٍ","Messenger","rasūlin",34,"رَّسُوْلٍ","রাসূল"],["إِلَّا","but","illā",17,"اِلَّا","এছাড়া যে"],["قَالُواْ","they said","qālū",6,"قَالُوْا","তারা বলে ছিল"],["سَاحِرٌ","A magician","sāḥirun",468,"سَاحِرٌ","\"(সে একজন) জাদুকর"],["أَوۡ","or","aw",40,"اَوْ","বা"],["مَجۡنُونٌ","a madman","majnūnun",796,"مَجْنُوْنٌ ۟ۚ","পাগল\""]]},{"v":53,"en":"Did they suggest it to them? Rather, they [themselves] are a transgressing people","bn":"তারা কি একে অপরকে এই উপদেশই দিয়ে গেছে? বস্তুতঃ ওরা দুষ্ট সম্প্রদায়।","w":[["أَتَوَاصَوۡاْ","Have they transmitted it to them","atawāṣaw",1432,"اَتَوَاصَوْا","তারা পরস্পরে কি পরামর্শ করে নিয়েছে"],["بِهِۦۚ","Have they transmitted it to them","bihi",10,"بِهٖ ۚ","সে বিষয়ে"],["بَلۡ","Nay","bal",94,"بَلْ","(না) বরং"],["هُمۡ","they","hum",13,"هُمْ","তারা(ছিল)"],["قَوۡمࣱ","(are) a people","qawmun",26,"قَوْمٌ","জাতি"],["طَاغُونَ","transgressing","ṭāghūna",1244,"طَاغُوْنَ ۟ۚ","দুর্বিনীত"]]},{"v":54,"en":"So leave them, [O Muhammad], for you are not to be blamed","bn":"অতএব, আপনি ওদের থেকে মুখ ফিরিয়ে নিন। এতে আপনি অপরাধী হবেন না।","w":[["فَتَوَلَّ","So turn away","fatawalla",139,"فَتَوَلَّ","তাই তুমি উপেক্ষা করো"],["عَنۡهُمۡ","from them","ʿanhum",22,"عَنْهُمْ","তাদের হতে"],["فَمَآ","for not","famā",2,"فَمَاۤ","আর নও"],["أَنتَ","you","anta",71,"اَنْتَ","তুমি"],["بِمَلُومٖ","(are) to be blamed","bimalūmin",1408,"بِمَلُوْمٍ ۟","তিরস্কৃত"]]},{"v":55,"en":"And remind, for indeed, the reminder benefits the believers","bn":"এবং বোঝাতে থাকুন; কেননা, বোঝানো মুমিনদের উপকারে আসবে।","w":[["وَذَكِّرۡ","And remind","wadhakkir",536,"وَّذَكِّرْ","এবং উপদেশ দাও"],["فَإِنَّ","for indeed","fa-inna",5,"فَاِنَّ","কেননা নিশ্চয়ই"],["ٱلذِّكۡرَىٰ","the reminder","l-dhik'rā",451,"الذِّكْرٰی","উপদেশ"],["تَنفَعُ","benefits","tanfaʿu",349,"تَنْفَعُ","উপকার দিবে"],["ٱلۡمُؤۡمِنِينَ","the believers","l-mu'minīna",54,"الْمُؤْمِنِیْنَ ۟","মু'মিনদেরকে"]]},{"v":56,"en":"And I did not create the jinn and mankind except to worship Me","bn":"আমার এবাদত করার জন্যই আমি মানব ও জিন জাতি সৃষ্টি করেছি।","w":[["وَمَا","And not","wamā",2,"وَمَا","এবং না"],["خَلَقۡتُ","I have created","khalaqtu",59,"خَلَقْتُ","আমি সৃষ্টি করেছি"],["ٱلۡجِنَّ","the jinn","l-jina",467,"ا