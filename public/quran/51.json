,"dhanūban",2740,"ذَنُوْبًا","(তাদের আছে) শাস্তির অংশ"],["مِّثۡلَ","like","mith'la",147,"مِّثْلَ","যেমনি"],["ذَنُوبِ","(the) portion","dhanūbi",2740,"ذَنُوْبِ","(প্রাপ্য ছিল) শাস্তির অংশ"],["أَصۡحَٰبِهِمۡ","(of) their companions","aṣḥābihim",138,"اَصْحٰبِهِمْ","তাদের সাথীদের"],["فَلَا","so let them not ask Me to hasten","falā",4,"فَلَا","না তাই (যেন)"],["يَسۡتَعۡجِلُونِ","so let them not ask Me to hasten","yastaʿjilūni",520,"یَسْتَعْجِلُوْنِ ۟","আমার কাছে তারা তাড়াহুড়া করে"]]},{"v":60,"en":"And woe to those who have disbelieved from their Day which they are promised","bn":"অতএব, কাফেরদের জন্যে দুর্ভোগ সেই দিনের, যেদিনের প্রতিশ্রুতি ওদেরকে দেয়া হয়েছে।","w":[["فَوَيۡلࣱ","Then woe","fawaylun",281,"فَوَیْلٌ","অতঃপর দুর্ভোগ"],["لِّلَّذِينَ","to those who","lilladhīna",7,"لِّلَّذِیْنَ","(তাদের) জন্যে যারা"],["كَفَرُواْ","disbelieve","kafarū",38,"كَفَرُوْا","অস্বীকার করেছে"],["مِن","from","min",0,"مِنْ","ব্যাপারে"],["يَوۡمِهِمُ","their Day","yawmihimu",21,"یَّوْمِهِمُ","তাদের (সেই) দিনের"],["ٱلَّذِي","which","alladhī",7,"الَّذِیْ","যার"],["يُوعَدُونَ","they are promised","yūʿadūna",170,"یُوْعَدُوْنَ ۟۠","ভয় তাদের দেখান হয়েছে"]]}]}