َنَسْتَدْرِجُهُمْ","শীঘ্রয় আমরা তাদের ক্রমে ক্রমে নিয়ে যাব"],["مِّنۡ","from","min",0,"مِّنْ","থেকে"],["حَيۡثُ","where","ḥaythu",347,"حَیْثُ","যেখান"],["لَا","not","lā",4,"لَا","না"],["يَعۡلَمُونَ","they know","yaʿlamūna",27,"یَعْلَمُوْنَ ۟ۙ","তারা জানতেও পারবে"]]},{"v":45,"en":"And I will give them time. Indeed, My plan is firm","bn":"আমি তাদেরকে সময় দেই। নিশ্চয় আমার কৌশল মজবুত।","w":[["وَأُمۡلِي","And I will give respite","wa-um'lī",902,"وَاُمْلِیْ","এবং আমি অবকাশ দিচ্ছি"],["لَهُمۡۚ","to them","lahum",13,"لَهُمْ ؕ","তাদের জন্যে"],["إِنَّ","Indeed","inna",5,"اِنَّ","নিশ্চয়"],["كَيۡدِي","My plan","kaydī",411,"كَیْدِیْ","আমার কাইদা(কোশল)"],["مَتِينٌ","(is) firm","matīnun",1889,"مَتِیْنٌ ۟","বলিষ্ঠ"]]},{"v":46,"en":"Or do you ask of them a payment, so they are by debt burdened down","bn":"আপনি কি তাদের কাছে পারিশ্রমিক চান? ফলে তাদের উপর জরিমানার বোঝা পড়ছে","w":[["أَمۡ","Or","am",85,"اَمْ","কি"],["تَسۡـَٔلُهُمۡ","you ask them","tasaluhum",105,"تَسْـَٔلُهُمْ","তাদের কাছে তুমি চাচ্ছ"],["أَجۡرٗا","a payment","ajran",108,"اَجْرًا","কোন পারিশ্রমিক"],["فَهُم","so they","fahum",13,"فَهُمْ","অতএব তারা"],["مِّن","from","min",0,"مِّنْ","থেকে"],["مَّغۡرَمٖ","(the) debt","maghramin",1915,"مَّغْرَمٍ","জরিমানা"],["مُّثۡقَلُونَ","(are) burdened","muth'qalūna",2749,"مُّثْقَلُوْنَ ۟ۚ","বোঝাগ্রস্থ"]]},{"v":47,"en":"Or have they [knowledge of] the unseen, so they write [it] down","bn":"না তাদের কাছে গায়বের খবর আছে? অতঃপর তারা তা লিপিবদ্ধ করে।","w":[["أَمۡ","Or","am",85,"اَمْ","কি"],["عِندَهُمُ","(is) with them","ʿindahumu",57,"عِنْدَهُمُ","তাদের কাছে আছে"],["ٱلۡغَيۡبُ","the unseen","l-ghaybu",232,"الْغَیْبُ","গায়েবের(জ্ঞান)"],["فَهُمۡ","so they","fahum",13,"فَهُمْ","বা তারা"],["يَكۡتُبُونَ","write it","yaktubūna",235,"یَكْتُبُوْنَ ۟","লিখে রাখে"]]},{"v":48,"en":"Then be patient for the decision of your Lord, [O Muhammad], and be not like the companion of the fish when he called out while he was distressed","bn":"আপনি আপনার পালনকর্তার আদেশের অপেক্ষায় সবর করুন এবং মাছওয়ালা ইউনুসের মত হবেন না, যখন সে দুঃখাকুল মনে প্রার্থনা করেছিল।","w":[["فَٱصۡبِرۡ","So be patient","fa-iṣ'bir",196,"فَاصْبِرْ","অতএব সবর কর"],["لِحُكۡمِ","for (the) decision","liḥuk'mi",362,"لِحُكْمِ","ফয়সালার জন্যে"],["رَبِّكَ","(of) your Lord","rabbika",12,"رَبِّكَ","তোমার রবের"],["وَلَا","and (do) not","walā",4,"وَلَا","এবং না"],["تَكُن","be","takun",9,"تَكُنْ","হয়ো"],["كَصَاحِبِ","like (the) companion","kaṣāḥibi",723,"كَصَاحِبِ","ওঁয়ালার মতো"],["ٱلۡحُوتِ","(of) the fish","l-ḥūti",1366,"الْحُوْتِ ۘ","মাছ"],["إِذۡ","when","idh",51,"اِذْ","যখন"],["نَادَىٰ","he called out","nādā",258,"نَادٰی","শসে ডেকেছিল"],["وَهُوَ","while he","wahuwa",10,"وَهُوَ","এবং সে"],["مَكۡظُومࣱ","(was) distressed","makẓūmun",4438,"مَكْظُوْمٌ ۟ؕ","বিষণ্ণ ছিল"]]},{"v":49,"en":"If not that a favor from his Lord overtook him, he would have been thrown onto the naked shore while he was censured","bn":"যদি তার পালনকর্তার অনুগ্রহ তাকে সামাল না দিত, তবে সে নিন্দিত অবস্থায় জনশুন্য প্রান্তরে নিক্ষিপ্ত হত।","w":[["لَّوۡلَآ","If not","lawlā",149,"لَوْلَاۤ","যদি না"],["أَن","that","an",18,"اَنْ","তাকে"],["تَدَٰرَكَهُۥ","overtook him","tadārakahu",1870,"تَدٰرَكَهٗ","পেতো"],["نِعۡمَةࣱ","a Favor","niʿ'matun",228,"نِعْمَةٌ","অনুগ্রহ"],["مِّن","from","min",0,"مِّنْ","থেকে"],["رَّبِّهِۦ","his Lord","rabbihi",12,"رَّبِّهٖ","তার রবের"],["لَنُبِذَ","surely he would have been thrown","lanubidha",811,"لَنُبِذَ","অবশ্যই নিক্ষিপ্ত হতো"],["بِٱلۡعَرَآءِ","onto (the) naked shore","bil-ʿarāi",2695,"بِالْعَرَآءِ","উন্মুক্ত প্রাস্তরে"],["وَهُوَ","while he","wahuwa",10,"وَهُوَ","এবং সে"],["مَذۡمُومࣱ","(was) blamed","madhmūmun",1981,"مَذْمُوْمٌ ۟","নিন্দিত হতো"]]},{"v":50,"en":"And his Lord chose him and made him of the righteous","bn":"অতঃপর তার পালনকর্তা তাকে মনোনীত করলেন এবং তাকে সৎকর্মীদের অন্তর্ভুক্ত করে নিলেন।","w":[["فَٱجۡتَبَٰهُ","But chose him","fa-ij'tabāhu",835,"فَاجْتَبٰىهُ","অতঃপর তাকে মনোনীত করলেন"],["رَبُّهُۥ","his Lord","rabbuhu",12,"رَبُّهٗ","তার রব"],["فَجَعَلَهُۥ","and made him","fajaʿalahu",32,"فَجَعَلَهٗ","তাই তাকে করলেন"],["مِنَ","of","mina",0,"مِنَ","অন্তর্ভুক্ত"],["ٱلصَّـٰلِحِينَ","the righteous","l-ṣāliḥīna",153,"الصّٰلِحِیْنَ ۟","নেক বান্দাদের"]]},{"v":51,"en":"And indeed, those who disbelieve would almost make you slip with their eyes when they hear the message, and they say, \"Indeed, he is mad","bn":"কাফেররা যখন কোরআন শুনে, তখন তারা তাদের দৃষ্টি দ্বারা যেন আপনাকে আছাড় দিয়ে ফেলে দিবে এবং তারা বলেঃ সে তো একজন পাগল।","w":[["وَإِن","And indeed","wa-in",16,"وَاِنْ","এবং যেন"],["يَكَادُ","would almost","yakādu",426,"یَّكَادُ","মনে হয়"],["ٱلَّذِينَ","those who","alladhīna",7,"الَّذِیْنَ","যারা"],["كَفَرُواْ","disbelieve","kafarū",38,"كَفَرُوْا","অস্বীকার করেছে"],["لَيُزۡلِقُونَكَ","surely make you slip","layuz'liqūnaka",4439,"لَیُزْلِقُوْنَكَ","অবশ্যই তোমাকে পদংখলন করাবে"],["بِأَبۡصَٰرِهِمۡ","with their look","bi-abṣārihim",238,"بِاَبْصَارِهِمْ","তাদের দৃষ্টিগুলো দিয়ে"],["لَمَّا","when","lammā",68,"لَمَّا","যখন"],["سَمِعُواْ","they hear","samiʿū",140,"سَمِعُوا","তারা শুনে"],["ٱلذِّكۡرَ","the Message","l-dhik'ra",146,"الذِّكْرَ","উপদেশ(কুরআন)"],["وَيَقُولُونَ","and they say","wayaqūlūna",6,"وَیَقُوْلُوْنَ","এবং তারা বলে"],["إِنَّهُۥ","Indeed, he","innahu",5,"اِنَّهٗ","\"সেনিশ্চয়"],["لَمَجۡنُونࣱ","(is) surely mad","lamajnūnun",796,"لَمَجْنُوْنٌ ۟ۘ","অবশ্যই পাগল\""]]},{"v":52,"en":"But it is not except a reminder to the worlds","bn":"অথচ এই কোরআন তো বিশ্বজগতের জন্যে উপদেশ বৈ নয়।","w":[["وَمَا","And not","wamā",2,"وَمَا","এবং নয়"],["هُوَ","it (is)","huwa",10,"هُوَ","তা"],["إِلَّا","but","illā",17,"اِلَّا","ছাড়া"],["ذِكۡرࣱ","a Reminder","dhik'run",146,"ذِكْرٌ","উপদেশ"],["لِّلۡعَٰلَمِينَ","to the worlds","lil'ʿālamīna",155,"لِّلْعٰلَمِیْنَ ۟۠","সারা বিশের জন্যে"]]}]}