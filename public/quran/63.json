ন তোমাদেরকে আল্লাহর স্মরণ থেকে গাফেল না করে। যারা এ কারণে গাফেল হয়, তারাই তো ক্ষতিগ্রস্ত।","w":[["يَـٰٓأَيُّهَا","O","yāayyuhā",53,"یٰۤاَیُّهَا","ওহে"],["ٱلَّذِينَ","you (who)","alladhīna",7,"الَّذِیْنَ","যারা"],["ءَامَنُواْ","believe","āmanū",19,"اٰمَنُوْا","ঈমান এনেছো"],["لَا","(Let) not","lā",4,"لَا","না"],["تُلۡهِكُمۡ","divert you","tul'hikum",1621,"تُلْهِكُمْ","তোমাদের (যেন) গাফিল করে"],["أَمۡوَٰلُكُمۡ","your wealth","amwālukum",125,"اَمْوَالُكُمْ","তোমাদের সম্পদগুলো"],["وَلَآ","and not","walā",4,"وَلَاۤ","ও না"],["أَوۡلَٰدُكُمۡ","your children","awlādukum",206,"اَوْلَادُكُمْ","তোমাদের সন্তানরা"],["عَن","from","ʿan",22,"عَنْ","থেকে"],["ذِكۡرِ","(the) remembrance","dhik'ri",146,"ذِكْرِ","স্মরণ"],["ٱللَّهِۚ","(of) Allah","l-lahi",1,"اللّٰهِ ۚ","আল্লাহর"],["وَمَن","And whoever","waman",14,"وَمَنْ","এবং যে"],["يَفۡعَلۡ","does","yafʿal",121,"یَّفْعَلْ","করবে"],["ذَٰلِكَ","that","dhālika",11,"ذٰلِكَ","এটা"],["فَأُوْلَـٰٓئِكَ","then those","fa-ulāika",11,"فَاُولٰٓىِٕكَ","অতঃপর ঐসব লোক"],["هُمُ","[they]","humu",13,"هُمُ","তারাই"],["ٱلۡخَٰسِرُونَ","(are) the losers","l-khāsirūna",339,"الْخٰسِرُوْنَ ۟","ক্ষতিগ্রস্ত"]]},{"v":10,"en":"And spend [in the way of Allah] from what We have provided you before death approaches one of you and he says, \"My Lord, if only You would delay me for a brief term so I would give charity and be among the righteous","bn":"আমি তোমাদেরকে যা দিয়েছি, তা থেকে মৃত্যু আসার আগেই ব্যয় কর। অন্যথায় সে বলবেঃ হে আমার পালনকর্তা, আমাকে আরও কিছুকাল অবকাশ দিলে না কেন? তাহলে আমি সদকা করতাম এবং সৎকর্মীদের অন্তর্ভুক্ত হতাম।","w":[["وَأَنفِقُواْ","And spend","wa-anfiqū",172,"وَاَنْفِقُوْا","এবং তোমরা খরচ করো"],["مِن","from","min",0,"مِنْ","থেকে"],["مَّا","what","mā",2,"مَّا","তা (যা)"],["رَزَقۡنَٰكُم","We have provided you","razaqnākum",190,"رَزَقْنٰكُمْ","তোমাদের আমরা রিজিক দিয়েছি"],["مِّن","from","min",0,"مِّنْ","থেকে"],["قَبۡلِ","before","qabli",49,"قَبْلِ","পূর্বে"],["أَن","[that]","an",18,"اَنْ","যে"],["يَأۡتِيَ","comes","yatiya",46,"یَّاْتِیَ","আসে"],["أَحَدَكُمُ","(to) one of you","aḥadakumu",154,"اَحَدَكُمُ","তোমাদের কারও"],["ٱلۡمَوۡتُ","the death","l-mawtu",226,"الْمَوْتُ","মৃত্যু"],["فَيَقُولَ","and he says","fayaqūla",6,"فَیَقُوْلَ","অতঃপর সে বলবে"],["رَبِّ","My Lord","rabbi",12,"رَبِّ","\"হে আমার রব"],["لَوۡلَآ","Why not","lawlā",149,"لَوْلَاۤ","কেন না"],["أَخَّرۡتَنِيٓ","You delay me","akhartanī",624,"اَخَّرْتَنِیْۤ","তুমি আমাকে অবকাশ দিলে"],["إِلَىٰٓ","for","ilā",15,"اِلٰۤی","পর্যন্ত"],["أَجَلٖ","a term","ajalin",219,"اَجَلٍ","কাল"],["قَرِيبٖ","near","qarībin",408,"قَرِیْبٍ ۙ","কিছু"],["فَأَصَّدَّقَ","so I would give charity","fa-aṣṣaddaqa",1156,"فَاَصَّدَّقَ","আমি তা হলে সদকা করতাম"],["وَأَكُن","and be","wa-akun",9,"وَاَكُنْ","এবং হতাম আমি"],["مِّنَ","among","mina",0,"مِّنَ","অন্তর্ভুক্ত"],["ٱلصَّـٰلِحِينَ","the righteous","l-ṣāliḥīna",153,"الصّٰلِحِیْنَ ۟","সৎকর্মশীলদের\""]]},{"v":11,"en":"But never will Allah delay a soul when its time has come. And Allah is Acquainted with what you do","bn":"প্রত্যেক ব্যক্তির নির্ধারিত সময় যখন উপস্থিত হবে, তখন আল্লাহ কাউকে অবকাশ দেবেন না। তোমরা যা কর, আল্লাহ সে বিষয়ে খবর রাখেন।","w":[["وَلَن","But never","walan",109,"وَلَنْ","অথচ কক্ষনো না"],["يُؤَخِّرَ","will (be) delayed","yu-akhira",624,"یُّؤَخِّرَ","অবকাশ দেন"],["ٱللَّهُ","(by) Allah","l-lahu",1,"اللّٰهُ","আল্লাহ"],["نَفۡسًا","a soul","nafsan",37,"نَفْسًا","কোন ব্যক্তিকে"],["إِذَا","when","idhā",24,"اِذَا","যখন"],["جَآءَ","has come","jāa",41,"جَآءَ","আসে"],["أَجَلُهَاۚ","its term","ajaluhā",219,"اَجَلُهَا ؕ","তার নির্ধারিত মেয়াদ"],["وَٱللَّهُ","And Allah","wal-lahu",1,"وَاللّٰهُ","আর আল্লাহ"],["خَبِيرُۢ","(is) All-Aware","khabīrun",252,"خَبِیْرٌ","সবিশেষ অবহিত"],["بِمَا","of what","bimā",2,"بِمَا","যা কিছু"],["تَعۡمَلُونَ","you do","taʿmalūna",42,"تَعْمَلُوْنَ ۟۠","তোমরা কাজ করো"]]}]}