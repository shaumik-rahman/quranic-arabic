তারা ছিল"],["فِيهِ","therein","fīhi",3,"فِیْهِ","যার মধ্যে"],["يَخۡتَلِفُونَ","differ","yakhtalifūna",325,"یَخْتَلِفُوْنَ ۟","মতবিরোধ করত"]]},{"v":18,"en":"Then We put you, [O Muhammad], on an ordained way concerning the matter [of religion]; so follow it and do not follow the inclinations of those who do not know","bn":"এরপর আমি আপনাকে রেখেছি ধর্মের এক বিশেষ শরীয়তের উপর। অতএব, আপনি এর অনুসরণ করুন এবং অজ্ঞানদের খেয়াল-খুশীর অনুসরণ করবেন না।","w":[["ثُمَّ","Then","thumma",33,"ثُمَّ","এরপর"],["جَعَلۡنَٰكَ","We put you","jaʿalnāka",32,"جَعَلْنٰكَ","তোমাকে আমরা প্রতিষ্ঠিত করেছি"],["عَلَىٰ","on","ʿalā",8,"عَلٰی","উপর"],["شَرِيعَةٖ","an ordained way","sharīʿatin",4156,"شَرِیْعَةٍ","শরীয়তের"],["مِّنَ","of","mina",0,"مِّنَ","সম্পর্কিত"],["ٱلۡأَمۡرِ","the matter","l-amri",67,"الْاَمْرِ","(দ্বীনের) নির্দেশ"],["فَٱتَّبِعۡهَا","so follow it","fa-ittabiʿ'hā",87,"فَاتَّبِعْهَا","তাই তার অনুসরণ করো"],["وَلَا","and (do) not","walā",4,"وَلَا","এবং না"],["تَتَّبِعۡ","follow","tattabiʿ",87,"تَتَّبِعْ","অনুসরণ করো"],["أَهۡوَآءَ","(the) desires","ahwāa",555,"اَهْوَآءَ","খেয়াল খুশির"],["ٱلَّذِينَ","(of) those who","alladhīna",7,"الَّذِیْنَ","(তাদের) যারা"],["لَا","(do) not","lā",4,"لَا","না"],["يَعۡلَمُونَ","know","yaʿlamūna",27,"یَعْلَمُوْنَ ۟","জানে"]]},{"v":19,"en":"Indeed, they will never avail you against Allah at all. And indeed, the wrongdoers are allies of one another; but Allah is the protector of the righteous","bn":"আল্লাহর সামনে তারা আপনার কোন উপকারে আসবে না। যালেমরা একে অপরের বন্ধু। আর আল্লাহ পরহেযগারদের বন্ধু।","w":[["إِنَّهُمۡ","Indeed, they","innahum",5,"اِنَّهُمْ","তারা নিশ্চয়ই"],["لَن","never","lan",109,"لَنْ","কখনও না"],["يُغۡنُواْ","will avail","yugh'nū",384,"یُّغْنُوْا","তারা কাজে আসবে"],["عَنكَ","you","ʿanka",22,"عَنْكَ","তোমার জন্যে"],["مِنَ","against","mina",0,"مِنَ","(পাকড়াও) হতে"],["ٱللَّهِ","Allah","l-lahi",1,"اللّٰهِ","আল্লাহর"],["شَيۡـٔٗاۚ","(in) anything","shayan",39,"شَیْـًٔا ؕ","কিছুমাত্র"],["وَإِنَّ","And indeed","wa-inna",5,"وَاِنَّ","এবং নিশ্চয়ই"],["ٱلظَّـٰلِمِينَ","the wrongdoers","l-ẓālimīna",92,"الظّٰلِمِیْنَ","সীমালঙ্ঘনকারীরা"],["بَعۡضُهُمۡ","some of them","baʿḍuhum",72,"بَعْضُهُمْ","তাদের একে"],["أَوۡلِيَآءُ","(are) allies","awliyāu",124,"اَوْلِیَآءُ","বন্ধু"],["بَعۡضٖۖ","(of) others","baʿḍin",72,"بَعْضٍ ۚ","অপরের"],["وَٱللَّهُ","and Allah","wal-lahu",1,"وَاللّٰهُ","এবং আল্লাহ"],["وَلِيُّ","(is the) Protector","waliyyu",124,"وَلِیُّ","বন্ধু"],["ٱلۡمُتَّقِينَ","(of) the righteous","l-mutaqīna",231,"الْمُتَّقِیْنَ ۟","মুত্তাকীদের"]]},{"v":20,"en":"This [Qur'an] is enlightenment for mankind and guidance and mercy for a people who are certain [in faith]","bn":"এটা মানুষের জন্যে জ্ঞানের কথা এবং বিশ্বাসী সম্প্রদায়ের জন্য হেদায়েত ও রহমত।","w":[["هَٰذَا","This","hādhā",11,"هٰذَا","এটা"],["بَصَـٰٓئِرُ","(is) enlightenment","baṣāiru",1081,"بَصَآىِٕرُ","(সঠিক পথের) আলো"],["لِلنَّاسِ","for mankind","lilnnāsi",50,"لِلنَّاسِ","সব লোকের জন্যে"],["وَهُدٗى","and guidance","wahudan",126,"وَهُدًی","এবং পথনির্দেশ"],["وَرَحۡمَةࣱ","and mercy","waraḥmatun",102,"وَّرَحْمَةٌ","ও অনুগ্রহ"],["لِّقَوۡمٖ","for a people","liqawmin",26,"لِّقَوْمٍ","(এমন) লোকদের জন্যে"],["يُوقِنُونَ","who are certain","yūqinūna",694,"یُّوْقِنُوْنَ ۟","(যারা) দৃঢ় বিশ্বাস করে"]]},{"v":21,"en":"Or do those who commit evils think We will make them like those who have believed and done righteous deeds - [make them] equal in their life and their death? Evil is that which they judge","bn":"যারা দুস্কর্ম উপার্জন করেছে তারা কি মনে করে যে, আমি তাদেরকে সে লোকদের মত করে দেব, যারা ঈমান আনে ও সৎকর্ম করে এবং তাদের জীবন ও মুত্যু কি সমান হবে? তাদের দাবী কত মন্দ।","w":[["أَمۡ","Do","am",85,"اَمْ","কি"],["حَسِبَ","think","ḥasiba",256,"حَسِبَ","মনে করেছে"],["ٱلَّذِينَ","those who","alladhīna",7,"الَّذِیْنَ","যারা"],["ٱجۡتَرَحُواْ","commit","ij'taraḥū",4157,"اجْتَرَحُوا","লিপ্ত রয়েছে"],["ٱلسَّيِّـَٔاتِ","evil deeds","l-sayiāti",197,"السَّیِّاٰتِ","পাপকাজ"],["أَن","that","an",18,"اَنْ","যে"],["نَّجۡعَلَهُمۡ","We will make them","najʿalahum",32,"نَّجْعَلَهُمْ","তাদেরকে করব আমরা"],["كَٱلَّذِينَ","like those who","ka-alladhīna",7,"كَالَّذِیْنَ","(তাদের) মতো যারা"],["ءَامَنُواْ","believed","āmanū",19,"اٰمَنُوْا","ঈমান এনেছে"],["وَعَمِلُواْ","and did","waʿamilū",42,"وَعَمِلُوا","ও কাজ করেছে"],["ٱلصَّـٰلِحَٰتِ","righteous deeds","l-ṣāliḥāti",188,"الصّٰلِحٰتِ ۙ","সৎ"],["سَوَآءٗ","equal","sawāan",387,"سَوَآءً","(উভয়ে) সমান"],["مَّحۡيَاهُمۡ","(in) their life","maḥyāhum",2317,"مَّحْیَاهُمْ","তাদের জীবন"],["وَمَمَاتُهُمۡۚ","and their death","wamamātuhum",1863,"وَمَمَاتُهُمْ ؕ","ও তাদের মৃত্যু (এক রকম হবে)"],["سَآءَ","Evil is","sāa",363,"سَآءَ","কত মন্দ"],["مَا","what","mā",2,"مَا","যা"],["يَحۡكُمُونَ","they judge","yaḥkumūna",250,"یَحْكُمُوْنَ ۟۠","তারা মীমাংসা করে"]]},{"v":22,"en":"And Allah created the heavens and earth in truth and so that every soul may be recompensed for what it has earned, and they will not be wronged","bn":"আল্লাহ নভোমন্ডল ও ভূ-মন্ডল যথাযথভাবে সৃষ্টি করেছেন, যাতে প্রত্যেক ব্যক্তি তার উপার্জনের ফল পায়। তাদের প্রতি যুলুম করা হবে না।","w":[["وَخَلَقَ","And Allah created","wakhalaqa",59,"وَخَلَقَ","এবং সৃষ্টি করেছেন"],["ٱللَّهُ","And Allah created","l-lahu",1,"اللّٰهُ","আল্লাহ"],["ٱلسَّمَٰوَٰتِ","the heavens","l-samāwāti",36,"السَّمٰوٰتِ","আকাশ"],["وَٱلۡأَرۡضَ","and the earth","wal-arḍa",23,"وَالْاَرْضَ","ও পৃথিবী"],["بِٱلۡحَقِّ","in truth","bil-ḥaqi",48,"بِالْحَقِّ","যথাযথভাবে"],["وَلِتُجۡزَىٰ","and that may be recompensed","walituj'zā",156,"وَلِتُجْزٰی","এবং যেন প্রতিদান দেওয়া যায়"],["كُلُّ","every","kullu",30,"كُلُّ","প্রত্যেক"],["نَفۡسِۭ","soul","nafsin",37,"نَفْسٍ","ব্যক্তিকে"],["بِمَا","for what","bimā",2,"بِمَا","ঐ বিষয়ে যা"],["كَسَبَتۡ","it has earned","kasabat",189,"كَسَبَتْ","সে অর্জন করেছে"],["وَهُمۡ","and they","wahum",13,"وَهُمْ","এবং তাদের (উপর)"],["لَا","will not be wronged","lā",4,"لَا","না"],["يُظۡلَمُونَ","will not be wronged","yuẓ'lamūna",103,"یُظْلَمُوْنَ ۟","যুলুম করা হবে"]]},{"v":23,"en":"Have you seen he who has taken as his god his [own] desire, and Allah has sent him astray due to knowledge and has set a seal upon his hearing and his heart and put over his vision a veil? So who will guide him after Allah? Then will you not be reminded","bn":"আপনি কি তার প্রতি লক্ষ্য করেছেন, যে তার খেয়াল-খুশীকে স্বীয় উপাস্য স্থির করেছে? আল্লাহ জেনে শুনে তাকে পথভ্রষ্ট করেছেন, তার কান ও অন্তরে মহর এঁটে দিয়েছেন এবং তার চোখের উপর রেখেছেন পর্দা। অতএব, আল্লাহর পর কে তাকে পথ প্রদর্শন করবে? তোমরা কি চিন্তাভাবনা কর না","w":[["أَفَرَءَيۡتَ","Have you seen","afara-ayta",44,"اَفَرَءَیْتَ","তুমি (ভেবে) দেখেছ কি"],["مَنِ","(he) who","mani",14,"مَنِ","যে"],["ٱتَّخَذَ","takes","ittakhadha",96,"اتَّخَذَ","বানিয়েছে"],["إِلَٰهَهُۥ","(as) his god","ilāhahu",78,"اِلٰهَهٗ","তার ইলাহ"],["هَوَىٰهُ","his desire","hawāhu",784,"هَوٰىهُ","নিজ প্রবৃত্তিকে"],["وَأَضَلَّهُ","and Allah lets him go astray","wa-aḍallahu",178,"وَاَضَلَّهُ","এবং তাকে পথভ্রষ্ট করেছে"],["ٱللَّهُ","and Allah lets him go astray","l-lahu",1,"اللّٰهُ","আল্লাহ"],["عَلَىٰ","knowingly","ʿalā",8,"عَلٰی","ভিত্তিতে"],["عِلۡمٖ","knowingly","ʿil'min",107,"عِلْمٍ","জ্ঞানের"],["وَخَتَمَ","and He sets a seal","wakhatama",1247,"وَّخَتَمَ","এবং মোহর মেরে দিয়েছেন"],["عَلَىٰ","upon","ʿalā",8,"عَلٰی","উপর"],["سَمۡعِهِۦ","his hearing","samʿihi",452,"سَمْعِهٖ","তার কানের"],["وَقَلۡبِهِۦ","and his heart","waqalbihi",88,"وَقَلْبِهٖ","ও তার অন্তরের"],["وَجَعَلَ","and puts","wajaʿala",32,"وَجَعَلَ","ও রেখে দিয়েছেন"],["عَلَىٰ","over","ʿalā",8,"عَلٰی","উপর"],["بَصَرِهِۦ","his vision","baṣarihi",238,"بَصَرِهٖ","তার চোখের"],["غِشَٰوَةٗ","a veil","ghishāwatan",2091,"غِشٰوَةً ؕ","আবরণ"],["فَمَن","Then who","faman",14,"فَمَنْ","সুতরাং কে"],["يَهۡدِيهِ","will guide him","yahdīhi",81,"یَّهْدِیْهِ","তাকে সৎপথ দেখাবে"],["مِنۢ","after","min",0,"مِنْ","মধ্য হতে"],["بَعۡدِ","after","baʿdi",56,"بَعْدِ","পরে"],["ٱللَّهِۚ","Allah","l-lahi",1,"اللّٰهِ ؕ","আল্লাহর"],["أَفَلَا","Then will not","afalā",4,"اَفَلَا","তবুও কি না"],["تَذَكَّرُونَ","you receive admonition","tadhakkarūna",225,"تَذَكَّرُوْنَ ۟","তোমরা শিক্ষা গ্রহণ করবে"]]},{"v":24,"en":"And they say, \"There is not but our worldly life; we die and live, and nothing destroys us except time.\" And they have of that no knowledge; they are only assuming","bn":"তারা বলে, আমাদের পার্থিব জীবনই তো শেষ; আমরা মরি ও বাঁচি মহাকালই আমাদেরকে ধ্বংস করে। তাদের কাছে এ ব্যাপারে কোন জ্ঞান নেই। তারা কেবল অনুমান করে কথা বলে।","w":[["وَقَالُواْ","And they say","waqālū",6,"وَقَالُوْا","এবং তারা বলে"],["مَا","Not","mā",2,"مَا","\"না"],["هِيَ","it","hiya",58,"هِیَ","সেটা (অর্থাৎ পূনরুত্থান)"],["إِلَّا","(is) but","illā",17,"اِلَّا","(যদি থাকে) তবে"],["حَيَاتُنَا","our life","ḥayātunā",145,"حَیَاتُنَا","আমাদের এ জীবন"],["ٱلدُّنۡيَا","(of) the world","l-dun'yā",101,"الدُّنْیَا","দুনিয়ার"],["نَمُوتُ","we die","namūtu",293,"نَمُوْتُ","আমরা মরি"],["وَنَحۡيَا","and we live","wanaḥyā",1083,"وَنَحْیَا","ও আমরা বাঁচি (তা সব এখানেই)"],["وَمَا","and not","wamā",2,"وَمَا","এবং না"],["يُهۡلِكُنَآ","destroys us","yuh'likunā",224,"یُهْلِكُنَاۤ","আমাদের ধ্বংস করে"],["إِلَّا","except","illā",17,"اِلَّا","এ ব্যতীত"],["ٱلدَّهۡرُۚ","the time","l-dahru",2722,"الدَّهْرُ ۚ","কালের (আবর্তন)\""],["وَمَا","And not","wamā",2,"وَمَا","এবং নেই"],["لَهُم","for them","lahum",13,"لَهُمْ","তাদের কাছে"],["بِذَٰلِكَ","of that","bidhālika",11,"بِذٰلِكَ","এ সম্বন্ধে"],["مِنۡ","any","min",0,"مِنْ","কোনো"],["عِلۡمٍۖ","knowledge","ʿil'min",107,"عِلْمٍ ۚ","জ্ঞান"],["إِنۡ","not","in",16,"اِنْ","না"],["هُمۡ","they","hum",13,"هُمْ","তারা"],["إِلَّا","(do) but","illā",17,"اِلَّا","এ ব্যতীত"],["يَظُنُّونَ","guess","yaẓunnūna",242,"یَظُنُّوْنَ ۟","অনুমান করে"]]},{"v":25,"en":"And when Our verses are recited to them as clear evidences, their argument is only that they say, \"Bring [back] our forefathers, if you should be truthful","bn":"তাদের কাছে যখন আমার সুস্পষ্ট আয়াতসমূহ পাঠ করা হয়, তখন একথা বলা ছাড়া তাদের কোন মুক্তিই থাকে না যে, তোমরা সত্যবাদী হলে আমাদের পূর্বপুরুষদেরকে নিয়ে আস।","w":[["وَإِذَا","And when","wa-idhā",24,"وَاِذَا","এবং যখন"],["تُتۡلَىٰ","are recited","tut'lā",191,"تُتْلٰی","আবৃত্তি করা হয়"],["عَلَيۡهِمۡ","to them","ʿalayhim",8,"عَلَیْهِمْ","তাদের কাছে"],["ءَايَٰتُنَا","Our Verses","āyātunā",28,"اٰیٰتُنَا","আমাদের আয়াতসমূহকে"],["بَيِّنَٰتٖ","clear","bayyinātin",162,"بَیِّنٰتٍ","সুস্পষ্ট"],["مَّا","not","mā",2,"مَّا","না"],["كَانَ","is","kāna",9,"كَانَ","থাকে"],["حُجَّتَهُمۡ","their argument","ḥujjatahum",1028,"حُجَّتَهُمْ","তাদের যুক্তি"],["إِلَّآ","except","illā",17,"اِلَّاۤ","এ ব্যতীত"],["أَن","that","an",18,"اَنْ","যে"],["قَالُواْ","they say","qālū",6,"قَالُوا","তারা বলে"],["ٱئۡتُواْ","Bring","i'tū",46,"ائْتُوْا","\"তোমরা উপস্থিত হও"],["بِـَٔابَآئِنَآ","our forefathers","biābāinā",180,"بِاٰبَآىِٕنَاۤ","আমাদের পিতৃপুরুষদেরকে নিয়ে"],["إِن","if","in",16,"اِنْ","যদি"],["كُنتُمۡ","you are","kuntum",9,"كُنْتُمْ","তোমরা হও"],["صَٰدِقِينَ","truthful","ṣādiqīna",192,"صٰدِقِیْنَ ۟","সত্যবাদী\""]]},{"v":26,"en":"Say, \"Allah causes you to live, then causes you to die; then He will assemble you for the Day of Resurrection, about which there is no doubt, but most of the people do not know","bn":"আপনি বলুন, আল্লাহই তোমাদেরকে জীবন দান করেন, অতঃপর মৃত্যু দেন, অতঃপর তোমাদেরকে কেয়ামতের দিন একত্রিত করবেন, যাতে কোন সন্দেহ নেই। কিন্তু অধিকাংশ মানুষ বোঝে না।","w":[["قُلِ","Say","quli",6,"قُلِ","বলো"],["ٱللَّهُ","Allah","l-lahu",1,"اللّٰهُ","\"আল্লাহই"],["يُحۡيِيكُمۡ","gives you life","yuḥ'yīkum",222,"یُحْیِیْكُمْ","তোমাদেরকে জীবন দেন"],["ثُمَّ","then","thumma",33,"ثُمَّ","এরপর"],["يُمِيتُكُمۡ","causes you to die","yumītukum",475,"یُمِیْتُكُمْ","তোমাদেরকে মৃত্যু দেন"],["ثُمَّ","then","thumma",33,"ثُمَّ","এরপর"],["يَجۡمَعُكُمۡ","He will gather you","yajmaʿukum",461,"یَجْمَعُكُمْ","তোমাদেরকে একত্র করবেন"],["إِلَىٰ","to","ilā",15,"اِلٰی","দিকে"],["يَوۡمِ","(the) Day","yawmi",21,"یَوْمِ","দিনের"],["ٱلۡقِيَٰمَةِ","(of) the Resurrection","l-qiyāmati",167,"الْقِیٰمَةِ","কিয়ামতের"],["لَا","no","lā",4,"لَا","নেই"],["رَيۡبَ","doubt","rayba",523,"رَیْبَ","কোন সন্দেহ"],["فِيهِ","about it","fīhi",3,"فِیْهِ","তার মধ্যে\""],["وَلَٰكِنَّ","But","walākinna",175,"وَلٰكِنَّ","কিন্তু"],["أَكۡثَرَ","most","akthara",136,"اَكْثَرَ","অধিকাংশ"],["ٱلنَّاسِ","(of) the people","l-nāsi",50,"النَّاسِ","মানুষই"],["لَا","(do) not","lā",4,"لَا","না"],["يَعۡلَمُونَ","know","yaʿlamūna",27,"یَعْلَمُوْنَ ۟۠","তারা জানে"]]},{"v":27,"en":"And to Allah belongs the dominion of the heavens and the earth. And the Day the Hour appears - that Day the falsifiers will lose","bn":"নভোমন্ডল ও ভূ-মন্ডলের রাজত্ব আল্লাহরই। যেদিন কেয়ামত সংঘটিত হবে, সেদিন মিথ্যাপন্থীরা ক্ষতিগ্রস্ত হবে।","w":[["وَلِلَّهِ","And for Allah","walillahi",1,"وَلِلّٰهِ","এবং আল্লাহরই জন্য"],["مُلۡكُ","(is the) dominion","mul'ku",240,"مُلْكُ","সার্বভৌমত্ব"],["ٱلسَّمَٰوَٰتِ","(of) the heavens","l-samāwāti",36,"السَّمٰوٰتِ","আকাশের"],["وَٱلۡأَرۡضِۚ","and the earth","wal-arḍi",23,"وَالْاَرْضِ ؕ","ও পৃথিবীর"],["وَيَوۡمَ","and (the) Day","wayawma",21,"وَیَوْمَ","এবং যেদিন"],["تَقُومُ","is established","taqūmu",332,"تَقُوْمُ","সংঘটিত হবে"],["ٱلسَّاعَةُ","the Hour","l-sāʿatu",241,"السَّاعَةُ","কিয়ামত"],["يَوۡمَئِذٖ","that Day","yawma-idhin",21,"یَوْمَىِٕذٍ","সেদিন"],["يَخۡسَرُ","will lose","yakhsaru",593,"یَّخْسَرُ","ক্ষতিগ্রস্ত হবে"],["ٱلۡمُبۡطِلُونَ","the falsifiers","l-mub'ṭilūna",1367,"الْمُبْطِلُوْنَ ۟","মিথ্যাশ্রয়ীরা"]]},{"v":28,"en":"And you will see every nation kneeling [from fear]. Every nation will be called to its record [and told], \"Today you will be recompensed for what you used to do","bn":"আপনি প্রত্যেক উম্মতকে দেখবেন নতজানু অবস্থায়। প্রত্যেক উম্মতকে তাদের আমলনামা দেখতে বলা হবে। তোমরা যা করতে, অদ্য তোমারদেরকে তার প্রতিফল দেয়া হবে।","w":[["وَتَرَىٰ","And you will see","watarā",44,"وَتَرٰی","এবং তুমি দেখবে"],["كُلَّ","every","kulla",30,"كُلَّ","প্রত্যেক"],["أُمَّةٖ","nation","ummatin",179,"اُمَّةٍ","দলকে"],["جَاثِيَةٗۚ","kneeling","jāthiyatan",4158,"جَاثِیَةً ۫","নতজানু অবস্থায়"],["كُلُّ","Every","kullu",30,"كُلُّ","প্রত্যেক"],["أُمَّةٖ","nation","ummatin",179,"اُمَّةٍ","দলকে"],["تُدۡعَىٰٓ","will be called","tud'ʿā",65,"تُدْعٰۤی","ডাকা হবে"],["إِلَىٰ","to","ilā",15,"اِلٰی","প্রতি"],["كِتَٰبِهَا","its record","kitābihā",47,"كِتٰبِهَا ؕ","তার আমলনামার"],["ٱلۡيَوۡمَ","Today","l-yawma",21,"اَلْیَوْمَ","\"(বলা হবে) আজ"],["تُجۡزَوۡنَ","you will be recompensed","tuj'zawna",156,"تُجْزَوْنَ","তোমাদের প্রতিফল দেওয়া হবে"],["مَا","(for) what","mā",2,"مَا","যা"],["كُنتُمۡ","you used to","kuntum",9,"كُنْتُمْ","তোমরা"],["تَعۡمَلُونَ","do","taʿmalūna",42,"تَعْمَلُوْنَ ۟","কাজ করছিলে"]]},{"v":29,"en":"This, Our record, speaks about you in truth. Indeed, We were having transcribed whatever you used to do","bn":"আমার কাছে রক্ষিত এই আমলনামা তোমাদের সম্পর্কে সত্য কথা বলবে। তোমরা যা করতে আমি তা লিপিবদ্ধ করতাম।","w":[["هَٰذَا","This","hādhā",11,"هٰذَا","এই"],["كِتَٰبُنَا","Our Record","kitābunā",47,"كِتٰبُنَا","আমাদের (তৈরী করা) আমলনামা"],["يَنطِقُ","speaks","yanṭiqu",933,"یَنْطِقُ","কথা বলছে"],["عَلَيۡكُم","about you","ʿalaykum",8,"عَلَیْكُمْ","তোমাদের বিরুদ্ধে"],["بِٱلۡحَقِّۚ","in truth","bil-ḥaqi",48,"بِالْحَقِّ ؕ","যথাযথভাবে"],["إِنَّا","Indeed, We","innā",5,"اِنَّا","আমরা নিশ্চয়ই"],["كُنَّا","[We] used to","kunnā",9,"كُنَّا","আমরা ছিলাম"],["نَسۡتَنسِخُ","transcribe","nastansikhu",4159,"نَسْتَنْسِخُ","আমরা সংরক্ষণ করি"],["مَا","what","mā",2,"مَا","যা কিছু"],["كُنتُمۡ","you used to","kuntum",9,"كُنْتُمْ","তোমরা ছিলে"],["تَعۡمَلُونَ","do","taʿmalūna",42,"تَعْمَلُوْنَ ۟","তোমরা কাজ করতে\""]]},{"v":30,"en":"So as for those who believed and did righteous deeds, their Lord will admit them into His mercy. That is what is the clear attainment","bn":"যারা বিশ্বাস স্থাপন করেছে ও সৎকর্ম করেছে, তাদেরকে তাদের পালনকর্তা স্বীয় রহমতে দাখিল করবেন। এটাই প্রকাশ্য সাফল্য।","w":[["فَأَمَّا","Then as for","fa-ammā",210,"فَاَمَّا","আর"],["ٱلَّذِينَ","those who","alladhīna",7,"الَّذِیْنَ","যারা"],["ءَامَنُواْ","believed","āmanū",19,"اٰمَنُوْا","ঈমান আনবে"],["وَعَمِلُواْ","and did","waʿamilū",42,"وَعَمِلُوا","ও কাজ করবে"],["ٱلصَّـٰلِحَٰتِ","[the] righteous deeds","l-ṣāliḥāti",188,"الصّٰلِحٰتِ","নেকীর"],["فَيُدۡخِلُهُمۡ","will admit them","fayud'khiluhum",268,"فَیُدْخِلُهُمْ","তখন তাদের প্রবেশ করাবেন"],["رَبُّهُمۡ","their Lord","rabbuhum",12,"رَبُّهُمْ","তাদের রব"],["فِي","in(to)","fī",3,"فِیْ","মধ্যে"],["رَحۡمَتِهِۦۚ","His mercy","raḥmatihi",102,"رَحْمَتِهٖ ؕ","তাঁর রহমতের"],["ذَٰلِكَ","That","dhālika",11,"ذٰلِكَ","এটাাই"],["هُوَ","[it]","huwa",10,"هُوَ","সেই"],["ٱلۡفَوۡزُ","(is) the success","l-fawzu",517,"الْفَوْزُ","সাফল্য"],["ٱلۡمُبِينُ","clear","l-mubīnu",99,"الْمُبِیْنُ ۟","সুস্পষ্ট"]]},{"v":31,"en":"But as for those who disbelieved, [it will be said], \"Were not Our verses recited to you, but you were arrogant and became a people of criminals","bn":"আর যারা কুফর করেছে, তাদেরকে জিজ্ঞাসা করা হবে, তোমাদের কাছে কি আয়াতসমূহ পঠিত হত না? কিন্তু তোমরা অহংকার করছিলে এবং তোমরা ছিলে এক অপরাধী সম্প্রদায়।","w":[["وَأَمَّا","But as for","wa-ammā",210,"وَاَمَّا","আর"],["ٱلَّذِينَ","those who","alladhīna",7,"الَّذِیْنَ","যারা"],["كَفَرُوٓاْ","disbelieved","kafarū",38,"كَفَرُوْا ۫","অস্বীকার করেছিল"],["أَفَلَمۡ","Then were not","afalam",31,"اَفَلَمْ","\"(তাদের বলা হবে) তবে কি"],["تَكُنۡ","Then were not","takun",9,"تَكُنْ","\"হয় নি"],["ءَايَٰتِي","My Verses","āyātī",28,"اٰیٰتِیْ","আমার নিদর্শনগুলো"],["تُتۡلَىٰ","recited","tut'lā",191,"تُتْلٰی","পঠিত"],["عَلَيۡكُمۡ","to you","ʿalaykum",8,"عَلَیْكُمْ","তোমাদের নিকট"],["فَٱسۡتَكۡبَرۡتُمۡ","but you were proud","fa-is'takbartum",278,"فَاسْتَكْبَرْتُمْ","কিন্তু তোমরা অহংকার করেছিলে"],["وَكُنتُمۡ","and you became","wakuntum",9,"وَكُنْتُمْ","এবং তোমরা ছিলে"],["قَوۡمٗا","a people","qawman",26,"قَوْمًا","সম্প্রদায়"],["مُّجۡرِمِينَ","criminals","muj'rimīna",220,"مُّجْرِمِیْنَ ۟","অপরাধী\""]]},{"v":32,"en":"And when it was said, 'Indeed, the promise of Allah is truth and the Hour [is coming] - no doubt about it,' you said, 'We know not what is the Hour. We assume only assumption, and we are not convinced","bn":"যখন বলা হত, আল্লাহর ওয়াদা সত্য এবং কেয়ামতে কোন সন্দেহ নেই, তখন তোমরা বলতে আমরা জানি না কেয়ামত কি ? আমরা কেবল ধারণাই করি এবং এ বিষয়ে আমরা নিশ্চিত নই।","w":[["وَإِذَا","And when","wa-idhā",24,"وَاِذَا","এবং যখন"],["قِيلَ","it was said","qīla",6,"قِیْلَ","বলা হতো"],["إِنَّ","Indeed","inna",5,"اِنَّ","\"নিশ্চয়ই"],["وَعۡدَ","(the) Promise","waʿda",237,"وَعْدَ","ওয়াদা"],["ٱللَّهِ","(of) Allah","l-lahi",1,"اللّٰهِ","আল্লাহর"],["حَقࣱّ","(is) true","ḥaqqun",48,"حَقٌّ","সত্য"],["وَٱلسَّاعَةُ","and the Hour","wal-sāʿatu",241,"وَّالسَّاعَةُ","এবং কিয়ামত (এমন যে)"],["لَا","(there is) no","lā",4,"لَا","নেই"],["رَيۡبَ","doubt","rayba",523,"رَیْبَ","কোনো সন্দেহ"],["فِيهَا","about it","fīhā",3,"فِیْهَا","তার মধ্যে"],["قُلۡتُم","you said","qul'tum",6,"قُلْتُمْ","তোমরা বলতে"],["مَّا","Not","mā",2,"مَّا","\"না"],["نَدۡرِي","we know","nadrī",722,"نَدْرِیْ","আমরা জানি"],["مَا","what","mā",2,"مَا","কি (জিনিস)"],["ٱلسَّاعَةُ","the Hour (is)","l-sāʿatu",241,"السَّاعَةُ ۙ","কিয়ামত"],["إِن","Not","in",16,"اِنْ","না"],["نَّظُنُّ","we think","naẓunnu",242,"نَّظُنُّ","আমরা ধারণা করি"],["إِلَّا","except","illā",17,"اِلَّا","এ ব্যতীত"],["ظَنّٗا","an assumption","ẓannan",487,"ظَنًّا","(সাধারণ) অনুমান নির্ভর কথা"],["وَمَا","and not","wamā",2,"وَّمَا","এবং নই"],["نَحۡنُ","we","naḥnu",64,"نَحْنُ","আমরা"],["بِمُسۡتَيۡقِنِينَ","(are) convinced","bimus'tayqinīna",4160,"بِمُسْتَیْقِنِیْنَ ۟","দৃঢ় বিশ্বাসী\""]]},{"v":33,"en":"And the evil consequences of what they did will appear to them, and they will be enveloped by what they used to ridicule","bn":"তাদের মন্দ কর্ম গুলো তাদের সামনে প্রকাশ হয়ে পড়বে এবং যে আযাব নিয়ে তারা ঠাট্টা-বিদ্রুপ করত, তা তাদেরকে গ্রাস করবে।","w":[["وَبَدَا","And (will) appear","wabadā",781,"وَبَدَا","এবং প্রকাশ হবে"],["لَهُمۡ","to them","lahum",13,"لَهُمْ","তাদের কাছে"],["سَيِّـَٔاتُ","(the) evil","sayyiātu",197,"سَیِّاٰتُ","মন্দ কাজগুলো"],["مَا","(of) what","mā",2,"مَا","যা কিছু"],["عَمِلُواْ","they did","ʿamilū",42,"عَمِلُوْا","তারা করেছিলো"],["وَحَاقَ","and (will) envelop","waḥāqa",842,"وَحَاقَ","এবং ঘিরে ফেলবে"],["بِهِم","them","bihim",13,"بِهِمْ","তাদেরকে"],["مَّا","what","mā",2,"مَّا","যা"],["كَانُواْ","they used","kānū",9,"كَانُوْا","তারা ছিল"],["بِهِۦ","[at it]","bihi",10,"بِهٖ","সে সম্বন্ধে"],["يَسۡتَهۡزِءُونَ","(to) mock","yastahziūna",471,"یَسْتَهْزِءُوْنَ ۟","বিদ্রুপ করত"]]},{"v":34,"en":"And it will be said, \"Today We will forget you as you forgot the meeting of this Day of yours, and your refuge is the Fire, and for you there are no helpers","bn":"বলা হবে, আজ আমি তোমাদেরকে ভুলে যাব, যেমন তোমরা এ দিনের সাক্ষাৎকে ভুলে গিয়েছিলে। তোমাদের আবাসস্থল জাহান্নাম এবং তোমাদের সাহায্যকারী নেই।","w":[["وَقِيلَ","And it will be said","waqīla",6,"وَقِیْلَ","এবং বলা হবে"],["ٱلۡيَوۡمَ","Today","l-yawma",21,"الْیَوْمَ","\"আজ"],["نَنسَىٰكُمۡ","We forget you","nansākum",321,"نَنْسٰىكُمْ","তোমাদেরকে ভুলে যাব আমরা"],["كَمَا","as","kamā",2,"كَمَا","যেমন"],["نَسِيتُمۡ","you forgot","nasītum",321,"نَسِیْتُمْ","তোমরা ভুলে গিয়েছিলে"],["لِقَآءَ","(the) meeting","liqāa",436,"لِقَآءَ","সাক্ষাতকে"],["يَوۡمِكُمۡ","(of) this Day of yours","yawmikum",21,"یَوْمِكُمْ","তোমাদের দিনের"],["هَٰذَا","(of) this Day of yours","hādhā",11,"هٰذَا","এই"],["وَمَأۡوَىٰكُمُ","and your abode","wamawākumu",464,"وَمَاْوٰىكُمُ","এবং তোমাদের আশ্রয়স্থল"],["ٱلنَّارُ","(is) the Fire","l-nāru",80,"النَّارُ","আগুন"],["وَمَا","and not","wamā",2,"وَمَا","এবং নেই"],["لَكُم","for you","lakum",20,"لَكُمْ","তোমাদের জন্য"],["مِّن","any","min",0,"مِّنْ","কেউ"],["نَّـٰصِرِينَ","helpers","nāṣirīna",778,"نّٰصِرِیْنَ ۟","সাহায্যকারীদের"]]},{"v":35,"en":"That is because you took the verses of Allah in ridicule, and worldly life deluded you.\" So that Day they will not be removed from it, nor will they be asked to appease [Allah]","bn":"এটা এজন্যে যে, তোমরা আল্লাহর আয়াতসমূহকে ঠাট্টারূপে গ্রহণ করেছিলে এবং পার্থিব জীবন তোমাদেরকে প্রতারিত করেছিল। সুতরাং আজ তাদেরকে জাহান্নাম থেকে বের করা হবে না এবং তাদের কাছে তওবা চাওয়া হবে না।","w":[["ذَٰلِكُم","That","dhālikum",11,"ذٰلِكُمْ","এটা তোমাদের"],["بِأَنَّكُمُ","(is) because you","bi-annakumu",29,"بِاَنَّكُمُ","এ কারণে যে"],["ٱتَّخَذۡتُمۡ","took","ittakhadhtum",96,"اتَّخَذْتُمْ","তোমরা গ্রহণ করেছিলে"],["ءَايَٰتِ","(the) Verses","āyāti",28,"اٰیٰتِ",