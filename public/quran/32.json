َّةِ","শীতলকারী (জিনিসসমূহ)"],["أَعۡيُنٖ","(for) the eyes","aʿyunin",202,"اَعْیُنٍ ۚ","চোখসমূহের"],["جَزَآءَۢ","(as) a reward","jazāan",266,"جَزَآءً","প্রতিদান হিসেবে"],["بِمَا","for what","bimā",2,"بِمَا","বিনিময়ে যা"],["كَانُواْ","they used (to)","kānū",9,"كَانُوْا","তারা ছিলো"],["يَعۡمَلُونَ","do","yaʿmalūna",42,"یَعْمَلُوْنَ ۟","তারা কাজ করতে"]]},{"v":18,"en":"Then is one who was a believer like one who was defiantly disobedient? They are not equal","bn":"ঈমানদার ব্যক্তি কি অবাধ্যের অনুরূপ? তারা সমান নয়।","w":[["أَفَمَن","Then is one who","afaman",14,"اَفَمَنْ","কি তবে যে"],["كَانَ","is","kāna",9,"كَانَ","হবে"],["مُؤۡمِنٗا","a believer","mu'minan",54,"مُؤْمِنًا","মু'মিন"],["كَمَن","like (him) who","kaman",14,"كَمَنْ","(সে কি তার) মতো যে"],["كَانَ","is","kāna",9,"كَانَ","হয়"],["فَاسِقٗاۚ","defiantly disobedient","fāsiqan",304,"فَاسِقًا ؔؕ","সত্যত্যাগী (দুষ্কৃতিকারী)"],["لَّا","Not","lā",4,"لَا","না"],["يَسۡتَوُۥنَ","they are equal","yastawūna",317,"یَسْتَوٗنَ ۟","তারা সমান হতে পারে"]]},{"v":19,"en":"As for those who believed and did righteous deeds, for them will be the Gardens of Refuge as accommodation for what they used to do","bn":"যারা ঈমান আনে ও সৎকর্ম করে, তাদের জন্যে রয়েছে তাদের কৃতকর্মের আপ্যায়নস্বরূপ বসবাসের জান্নাত।","w":[["أَمَّا","As for","ammā",210,"اَمَّا","(আর তাদের)ব্যাপার"],["ٱلَّذِينَ","those who","alladhīna",7,"الَّذِیْنَ","যারা"],["ءَامَنُواْ","believe","āmanū",19,"اٰمَنُوْا","ঈমান এনেছে"],["وَعَمِلُواْ","and do","waʿamilū",42,"وَعَمِلُوا","ও কাজ করেছে"],["ٱلصَّـٰلِحَٰتِ","righteous deeds","l-ṣāliḥāti",188,"الصّٰلِحٰتِ","সৎ"],["فَلَهُمۡ","then for them","falahum",13,"فَلَهُمْ","অতঃপর জন্যে তাদের"],["جَنَّـٰتُ","(are) Gardens","jannātu",77,"جَنّٰتُ","জান্নাতসমূহ"],["ٱلۡمَأۡوَىٰ","(of) Refuge","l-mawā",464,"الْمَاْوٰی ؗ","বসবাসের"],["نُزُلَۢا","(as) hospitality","nuzulan",972,"نُزُلًا","আপ্যায়ন হিসেবে"],["بِمَا","for what","bimā",2,"بِمَا","বিনিময়ে যা"],["كَانُواْ","they used (to)","kānū",9,"كَانُوْا","তারা ছিলো"],["يَعۡمَلُونَ","do","yaʿmalūna",42,"یَعْمَلُوْنَ ۟","তারা কাজ করতে"]]},{"v":20,"en":"But as for those who defiantly disobeyed, their refuge is the Fire. Every time they wish to emerge from it, they will be returned to it while it is said to them, \"Taste the punishment of the Fire which you used to deny","bn":"পক্ষান্তরে যারা অবাধ্য হয়, তাদের ঠিকানা জাহান্নাম। যখনই তারা জাহান্নাম থেকে বের হতে চাইবে, তখনই তাদেরকে তথায় ফিরিয়ে দেয়া হবে এবং তাদেরকে বলা হবে, তোমরা জাহান্নামের যে আযাবকে মিথ্যা বলতে, তার স্বাদ আস্বাদন কর।","w":[["وَأَمَّا","But as for","wa-ammā",210,"وَاَمَّا","আর(তাদের)ক্ষেত্রে"],["ٱلَّذِينَ","those who","alladhīna",7,"الَّذِیْنَ","যারা"],["فَسَقُواْ","are defiantly disobedient","fasaqū",806,"فَسَقُوْا","সত্যত্যাগ করেছে"],["فَمَأۡوَىٰهُمُ","then their refuge","famawāhumu",464,"فَمَاْوٰىهُمُ","অতঃপর বাসস্থান হবে তাদের"],["ٱلنَّارُۖ","(is) the Fire","l-nāru",80,"النَّارُ ؕ","আগুন"],["كُلَّمَآ","Every time","kullamā",601,"كُلَّمَاۤ","যখনই"],["أَرَادُوٓاْ","they wish","arādū",84,"اَرَادُوْۤا","তারা ইচ্ছে করবে"],["أَن","to","an",18,"اَنْ","যে"],["يَخۡرُجُواْ","come out","yakhrujū",215,"یَّخْرُجُوْا","তারা বের হবে"],["مِنۡهَآ","from it","min'hā",0,"مِنْهَاۤ","থেকে তা"],["أُعِيدُواْ","they (will) be returned","uʿīdū",545,"اُعِیْدُوْا","ফিরিয়ে দেওয়া হবে"],["فِيهَا","in it","fīhā",3,"فِیْهَا","মধ্যে তার"],["وَقِيلَ","and it (will) be said","waqīla",6,"وَقِیْلَ","এবং বলা হবে"],["لَهُمۡ","to them","lahum",13,"لَهُمْ","উদ্দেশ্যে তাদের"],["ذُوقُواْ","Taste","dhūqū",315,"ذُوْقُوْا","\"তোমরা স্বাদ নাও"],["عَذَابَ","(the) punishment","ʿadhāba",35,"عَذَابَ","শাস্তির"],["ٱلنَّارِ","(of) the Fire","l-nāri",80,"النَّارِ","আগুনের"],["ٱلَّذِي","which","alladhī",7,"الَّذِیْ","যা"],["كُنتُم","you used (to)","kuntum",9,"كُنْتُمْ","তোমরা ছিলে"],["بِهِۦ","[in it]","bihi",10,"بِهٖ","সম্বন্ধে সে"],["تُكَذِّبُونَ","deny","tukadhibūna",62,"تُكَذِّبُوْنَ ۟","মিথ্যারোপ করতে\""]]},{"v":21,"en":"And we will surely let them taste the nearer punishment short of the greater punishment that perhaps they will repent","bn":"গুরু শাস্তির পূর্বে আমি অবশ্যই তাদেরকে লঘু শাস্তি আস্বাদন করাব, যাতে তারা প্রত্যাবর্তন করে।","w":[["وَلَنُذِيقَنَّهُم","And surely, We will let them taste","walanudhīqannahum",466,"وَلَنُذِیْقَنَّهُمْ","এবং অবশ্যই আস্বাদন করাবোই আমরা তাদের"],["مِّنَ","of","mina",0,"مِّنَ","কিছু"],["ٱلۡعَذَابِ","the punishment","l-ʿadhābi",35,"الْعَذَابِ","শাস্তি (দ্বারা)"],["ٱلۡأَدۡنَىٰ","the nearer","l-adnā",698,"الْاَدْنٰی","হালকা (দুনিয়ার)"],["دُونَ","before","dūna",82,"دُوْنَ","ছাড়াও"],["ٱلۡعَذَابِ","the punishment","l-ʿadhābi",35,"الْعَذَابِ","শাস্তি (আখেরাতের)"],["ٱلۡأَكۡبَرِ","the greater","l-akbari",431,"الْاَكْبَرِ","বড়"],["لَعَلَّهُمۡ","so that they may","laʿallahum",91,"لَعَلَّهُمْ","সম্ভবত তারা"],["يَرۡجِعُونَ","return","yarjiʿūna",137,"یَرْجِعُوْنَ ۟","ফিরে আসবে"]]},{"v":22,"en":"And who is more unjust than one who is reminded of the verses of his Lord; then he turns away from them? Indeed We, from the criminals, will take retribution","bn":"যে ব্যক্তিকে তার পালনকর্তার আয়াতসমূহ দ্বারা উপদেশ দান করা হয়, অতঃপর সে তা থেকে মুখ ফিরিয়ে নেয়, তার চেয়ে যালেম আর কে? আমি অপরাধীদেরকে শাস্তি দেব।","w":[["وَمَنۡ","And who","waman",14,"وَمَنْ","এবং কে"],["أَظۡلَمُ","(is) more unjust","aẓlamu",575,"اَظْلَمُ","বড় সীমালঙ্ঘনকারী"],["مِمَّن","than (he) who","mimman",0,"مِمَّنْ","(তার) চেয়ে যাকে"],["ذُكِّرَ","is reminded","dhukkira",536,"ذُكِّرَ","উপদেশ দেওয়া হয়"],["بِـَٔايَٰتِ","of (the) Verses","biāyāti",28,"بِاٰیٰتِ","দিয়ে নিদর্শন সমূহ"],["رَبِّهِۦ","(of) his Lord","rabbihi",12,"رَبِّهٖ","রবের তার"],["ثُمَّ","then","thumma",33,"ثُمَّ","এরপরও"],["أَعۡرَضَ","he turns away","aʿraḍa",346,"اَعْرَضَ","সে মুখ ফিরিয়ে নেয়"],["عَنۡهَآۚ","from them","ʿanhā",22,"عَنْهَا ؕ","থেকে তা"],["إِنَّا","Indeed, We","innā",5,"اِنَّا","নিশ্চয়ই আমরা"],["مِنَ","from","mina",0,"مِنَ","থেকে"],["ٱلۡمُجۡرِمِينَ","the criminals","l-muj'rimīna",220,"الْمُجْرِمِیْنَ","অপরাধীদের"],["مُنتَقِمُونَ","(will) take retribution","muntaqimūna",2052,"مُنْتَقِمُوْنَ ۟۠","প্রতিশোধ গ্রহণকারী"]]},{"v":23,"en":"And We certainly gave Moses the Scripture, so do not be in doubt over his meeting. And we made the Torah guidance for the Children of Israel","bn":"আমি মূসাকে কিতাব দিয়েছি, অতএব আপনি কোরআন প্রাপ্তির বিষয়ে কোন সন্দেহ করবেন না। আমি একে বনী ইসরাঈলের জন্যে পথ প্রদর্শক করেছিলাম।","w":[["وَلَقَدۡ","And certainly","walaqad",25,"وَلَقَدْ","এবং নিশ্চয়ই"],["ءَاتَيۡنَا","We gave","ātaynā",43,"اٰتَیْنَا","দিয়েছি আমরা"],["مُوسَى","Musa","mūsā",86,"مُوْسَی","মূসাকে"],["ٱلۡكِتَٰبَ","the Scripture","l-kitāba",47,"الْكِتٰبَ","কিতাব"],["فَلَا","so (do) not","falā",4,"فَلَا","সুতরাং না (যেন)"],["تَكُن","be","takun",9,"تَكُنْ","তুমি হয়ো (থাকো)"],["فِي","in","fī",3,"فِیْ","মধ্যে"],["مِرۡيَةٖ","doubt","mir'yatin",1384,"مِرْیَةٍ","সন্দেহের"],["مِّن","about","min",0,"مِّنْ","ব্যাপারে"],["لِّقَآئِهِۦۖ","receiving it","liqāihi",436,"لِّقَآىِٕهٖ","পাওয়ার তা"],["وَجَعَلۡنَٰهُ","And We made it","wajaʿalnāhu",32,"وَجَعَلْنٰهُ","এবং আমরা বানিয়েছিলাম তাকে"],["هُدٗى","a guide","hudan",126,"هُدًی","পথনির্দেশনা"],["لِّبَنِيٓ","for the Children of Israel","libanī",135,"لِّبَنِیْۤ","জন্যে সন্তানদের"],["إِسۡرَـٰٓءِيلَ","for the Children of Israel","is'rāīla",262,"اِسْرَآءِیْلَ ۟ۚ","ইসরাঈলের"]]},{"v":24,"en":"And We made from among them leaders guiding by Our command when they were patient and [when] they were certain of Our signs","bn":"তারা সবর করত বিধায় আমি তাদের মধ্য থেকে নেতা মনোনীত করেছিলাম, যারা আমার আদেশে পথ প্রদর্শন করত। তারা আমার আয়াতসমূহে দৃঢ় বিশ্বাসী ছিল।","w":[["وَجَعَلۡنَا","And We made","wajaʿalnā",32,"وَجَعَلْنَا","এবং মনোনীত করেছিলাম আমরা"],["مِنۡهُمۡ","from them","min'hum",0,"مِنْهُمْ","মধ্যে থেকে তাদের"],["أَئِمَّةٗ","leaders","a-immatan",704,"اَىِٕمَّةً","(অনেক) নেতা"],["يَهۡدُونَ","guiding","yahdūna",81,"یَّهْدُوْنَ","(যারা) পথ দেখাতো"],["بِأَمۡرِنَا","by Our Command","bi-amrinā",67,"بِاَمْرِنَا","অনুসারে আমাদের নির্দেশ"],["لَمَّا","when","lammā",68,"لَمَّا","যখন"],["صَبَرُواْۖ","they were patient","ṣabarū",196,"صَبَرُوْا ؕ۫","তারা ধৈর্য ধরেছিলো"],["وَكَانُواْ","and they were","wakānū",9,"وَكَانُوْا","এবং তারা ছিলো"],["بِـَٔايَٰتِنَا","of Our Verses","biāyātinā",28,"بِاٰیٰتِنَا","প্রতি আমাদের নিদর্শনগুলোর"],["يُوقِنُونَ","certain","yūqinūna",694,"یُوْقِنُوْنَ ۟","দৃঢ়বিশ্বাস করতো"]]},{"v":25,"en":"Indeed, your Lord will judge between them on the Day of Resurrection concerning that over which they used to differ","bn":"তারা যে বিষয়ে মত বিরোধ করছে, আপনার পালনকর্তাই কেয়ামতের দিন সে বিষয়ে তাদের মধ্যে ফয়সালা দেবেন।","w":[["إِنَّ","Indeed","inna",5,"اِنَّ","নিশ্চয়ই"],["رَبَّكَ","your Lord","rabbaka",12,"رَبَّكَ","তোমার রব"],["هُوَ","[He]","huwa",10,"هُوَ","তিনিই"],["يَفۡصِلُ","will judge","yafṣilu",1279,"یَفْصِلُ","মীমাংসা করে দিবেন"],["بَيۡنَهُمۡ","between them","baynahum",45,"بَیْنَهُمْ","মাঝে তাদের"],["يَوۡمَ","(on the) Day","yawma",21,"یَوْمَ","দিনে"],["ٱلۡقِيَٰمَةِ","(of) Resurrection","l-qiyāmati",167,"الْقِیٰمَةِ","ক্বিয়ামাতের"],["فِيمَا","in what","fīmā",3,"فِیْمَا","ঐ বিষয়ে যা"],["كَانُواْ","they used (to)","kānū",9,"كَانُوْا","তারা ছিলো"],["فِيهِ","[in it]","fīhi",3,"فِیْهِ","বিষয়ে সে"],["يَخۡتَلِفُونَ","differ","yakhtalifūna",325,"یَخْتَلِفُوْنَ ۟","তারা মত-বিরোধ করতো"]]},{"v":26,"en":"Has it not become clear to them how many generations We destroyed before them, [as] they walk among their dwellings? Indeed in that are signs; then do they not hear","bn":"এতে কি তাদের চোখ খোলেনি যে, আমি তাদের পূর্বে অনেক সম্প্রদায়কে ধ্বংস করেছি, যাদের বাড়ী-ঘরে এরা বিচরণ করে। অবশ্যই এতে নিদর্শনাবলী রয়েছে। তারা কি শোনে না","w":[["أَوَلَمۡ","Does it not","awalam",31,"اَوَلَمْ","(এটাও) কি না"],["يَهۡدِ","guide","yahdi",81,"یَهْدِ","পথপ্রদর্শন করে"],["لَهُمۡ","[for] them","lahum",13,"لَهُمْ","জন্যে তাদের"],["كَمۡ","(that) how many","kam",481,"كَمْ","কতই (না)"],["أَهۡلَكۡنَا","We have destroyed","ahlaknā",224,"اَهْلَكْنَا","ধ্বংস করেছি আমরা"],["مِن","before them","min",0,"مِنْ","থেকে"],["قَبۡلِهِم","before them","qablihim",49,"قَبْلِهِمْ","পূর্ব তাদের"],["مِّنَ","of","mina",0,"مِّنَ","মধ্য হ'তে"],["ٱلۡقُرُونِ","the generations","l-qurūni",450,"الْقُرُوْنِ","