{"n":93,"verses":[{"v":1,"en":"By the morning brightness","bn":"শপথ পূর্বাহ্নের","w":[["وَٱلضُّحَىٰ","By the morning brightness","wal-ḍuḥā",1200,"وَالضُّحٰی ۟ۙ","শপথ প্রথম প্রহরের"]]},{"v":2,"en":"And [by] the night when it covers with darkness","bn":"শপথ রাত্রির যখন তা গভীর হয়","w":[["وَٱلَّيۡلِ","And the night","wa-al-layli",129,"وَالَّیْلِ","শপথ রাতের"],["إِذَا","when","idhā",24,"اِذَا","যখন"],["سَجَىٰ","it covers with darkness","sajā",4720,"سَجٰی ۟ۙ","নিঝুম হয়"]]},{"v":3,"en":"Your Lord has not taken leave of you, [O Muhammad], nor has He detested [you]","bn":"আপনার পালনকর্তা আপনাকে ত্যাগ করেনি এবং আপনার প্রতি বিরূপও হননি।","w":[["مَا","Not","mā",2,"مَا","না"],["وَدَّعَكَ","has forsaken you","waddaʿaka",4721,"وَدَّعَكَ","তোমাকে ত্যাগ করেছেন"],["رَبُّكَ","your Lord","rabbuka",12,"رَبُّكَ","তোমার রব"],["وَمَا","and not","wamā",2,"وَمَا","আর না"],["قَلَىٰ","He is displeased","qalā",4722,"قَلٰی ۟ؕ","অসন্তুষ্ট হয়েছেন"]]},{"v":4,"en":"And the Hereafter is better for you than the first [life]","bn":"আপনার জন্যে পরকাল ইহকাল অপেক্ষা শ্রেয়।","w":[["وَلَلۡأٓخِرَةُ","And surely the Hereafter","walalākhiratu",75,"وَلَلْاٰخِرَةُ","এবং পরবর্তী (পরকাল) নিশ্চয়ই"],["خَيۡرࣱ","(is) better","khayrun",61,"خَیْرٌ","উত্তম"],["لَّكَ","for you","laka",71,"لَّكَ","তোমার জন্য"],["مِنَ","than","mina",0,"مِنَ","অপেক্ষা (সময়)"],["ٱلۡأُولَىٰ","the first","l-ūlā",134,"الْاُوْلٰی ۟ؕ","পূর্ববর্তী (ইহকাল)"]]},{"v":5,"en":"And your Lord is going to give you, and you will be satisfied","bn":"আপনার পালনকর্তা সত্বরই আপনাকে দান করবেন, অতঃপর আপনি সন্তুষ্ট হবেন।","w":[["وَلَسَوۡفَ","And soon","walasawfa",269,"وَلَسَوْفَ","এবং শীঘ্রই অবশ্য"],["يُعۡطِيكَ","will give you","yuʿ'ṭīka",997,"یُعْطِیْكَ","তোমাকে দান করবেন"],["رَبُّكَ","your Lord","rabbuka",12,"رَبُّكَ","তোমার রব"],["فَتَرۡضَىٰٓ","then you will be satisfied","fatarḍā",300,"فَتَرْضٰی ۟ؕ","ফলে তুমি খুশী হবে"]]},{"v":6,"en":"Did He not find you an orphan and give [you] refuge","bn":"তিনি কি আপনাকে এতীমরূপে পাননি? অতঃপর তিনি আশ্রয় দিয়েছেন।","w":[["أَلَمۡ","Did not","alam",31,"اَلَمْ","পান নি কি"],["يَجِدۡكَ","He find you","yajid'ka",106,"یَجِدْكَ","তিনি তোমাকে"],["يَتِيمٗا","an orphan","yatīman",444,"یَتِیْمًا","ইয়াতীমরূপে"],["فَـَٔاوَىٰ","and give shelter","faāwā",919,"فَاٰوٰی ۪۟","অতঃপর আশ্রয় দিয়েছেন"]]},{"v":7,"en":"And He found you lost and guided [you]","bn":"তিনি আপনাকে পেয়েছেন পথহারা, অতঃপর পথপ্রদর্শন করেছেন।","w":[["وَوَجَدَكَ","And He found you","wawajadaka",106,"وَوَجَدَكَ","এবং  তিনি তোমাকে পেয়েছিলেন"],["ضَآلّٗا","lost","ḍāllan",631,"ضَآلًّا","পথ অনবহিত (রূপে)"],["فَهَدَىٰ","so He guided","fahadā",81,"فَهَدٰی ۪۟","অতঃপর তিনি পথের দিশা দেন"]]},{"v":8,"en":"And He found you poor and made [you] self-sufficient","bn":"তিনি আপনাকে পেয়েছেন নিঃস্ব, অতঃপর অভাবমুক্ত করেছেন।","w":[["وَوَجَدَكَ","And He found you","wawajadaka",106,"وَوَجَدَكَ","এবং তোমাকে পেয়েছিলেন"],["عَآئِلٗا","in need","ʿāilan",4723,"عَآىِٕلًا","অভাবী"],["فَأَغۡنَىٰ","so He made self-sufficient","fa-aghnā",629,"فَاَغْنٰی ۟ؕ","অতঃপর অভাবমুক্ত করলেন"]]},{"v":9,"en":"So as for the orphan, do not oppress [him]","bn":"সুতরাং আপনি এতীমের প্রতি কঠোর হবেন না","w":[["فَأَمَّا","So as for","fa-ammā",210,"فَاَمَّا","সুতরাং ক্ষেত্রে"],["ٱلۡيَتِيمَ","the orphan","l-yatīma",444,"الْیَتِیْمَ","ইয়াতীমের"],["فَلَا","then (do) not","falā",4,"فَلَا","তাই না"],["تَقۡهَرۡ","oppress","taqhar",4724,"تَقْهَرْ ۟ؕ","কঠোর হয়ো"]]},{"v":10,"en":"And as for the petitioner, do not repel [him]","bn":"সওয়ালকারীকে ধমক দেবেন না।","w":[["وَأَمَّا","And as for","wa-ammā",210,"وَاَمَّا","আর ক্ষেত্রে"],["ٱلسَّآئِلَ","one who asks","l-sāila",1032,"السَّآىِٕلَ","প্রার্থীর"],["فَلَا","then (do) not","falā",4,"فَلَا","তাই না"],["تَنۡهَرۡ","repel","tanhar",2487,"تَنْهَرْ ۟ؕ","তিরস্কার করো"]]},{"v":11,"en":"But as for the favor of your Lord, report [it]","bn":"এবং আপনার পালনকর্তার নেয়ামতের কথা প্রকাশ করুন।","w":[["وَأَمَّا","But as for","wa-ammā",210,"وَاَمَّا","আর প্রসঙ্গ"],["بِنِعۡمَةِ","(the) Favor","biniʿ'mati",228,"بِنِعْمَةِ","অনুগ্রহের"],["رَبِّكَ","(of) your Lord","rabbika",12,"رَبِّكَ","তোমার রবের"],["فَحَدِّثۡ","narrate","faḥaddith",1706,"فَحَدِّثْ ۟۠","অতঃপর বর্ণনা করো"]]}]}