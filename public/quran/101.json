{"n":101,"verses":[{"v":1,"en":"The Striking Calamity","bn":"করাঘাতকারী","w":[["ٱلۡقَارِعَةُ","The Striking Calamity","al-qāriʿatu",1400,"اَلْقَارِعَةُ ۟ۙ","মহাপ্রলয়"]]},{"v":2,"en":"What is the Striking Calamity","bn":"করাঘাতকারী কি","w":[["مَا","What","mā",2,"مَا","কি সেই"],["ٱلۡقَارِعَةُ","(is) the Striking Calamity","l-qāriʿatu",1400,"الْقَارِعَةُ ۟ۚ","মহাপ্রলয়"]]},{"v":3,"en":"And what can make you know what is the Striking Calamity","bn":"করাঘাতকারী সম্পর্কে আপনি কি জানেন","w":[["وَمَآ","And what","wamā",2,"وَمَاۤ","এবং কিসে"],["أَدۡرَىٰكَ","will make you know","adrāka",571,"اَدْرٰىكَ","তোমাকে জানাবে"],["مَا","what","mā",2,"مَا","মহাপ্রলয়"],["ٱلۡقَارِعَةُ","(is) the Striking Calamity","l-qāriʿatu",1400,"الْقَارِعَةُ ۟ؕ","ভয়াবহ দুর্ঘটনা"]]},{"v":4,"en":"It is the Day when people will be like moths, dispersed","bn":"যেদিন মানুষ হবে বিক্ষিপ্ত পতংগের মত","w":[["يَوۡمَ","(The) Day","yawma",21,"یَوْمَ","সেদিন"],["يَكُونُ","will be","yakūnu",9,"یَكُوْنُ","হবে"],["ٱلنَّاسُ","the mankind","l-nāsu",50,"النَّاسُ","মানুষ"],["كَٱلۡفَرَاشِ","like moths","kal-farāshi",4745,"كَالْفَرَاشِ","পতঙ্গের মতো"],["ٱلۡمَبۡثُوثِ","scattered","l-mabthūthi",4746,"الْمَبْثُوْثِ ۟ۙ","বিক্ষিপ্ত"]]},{"v":5,"en":"And the mountains will be like wool, fluffed up","bn":"এবং পর্বতমালা হবে ধুনিত রঙ্গীন পশমের মত।","w":[["وَتَكُونُ","And will be","watakūnu",9,"وَتَكُوْنُ","এবং হবে"],["ٱلۡجِبَالُ","the mountains","l-jibālu",296,"الْجِبَالُ","পাহাড়সমূহ"],["كَٱلۡعِهۡنِ","like wool","kal-ʿih'ni",2786,"كَالْعِهْنِ","রঙিন পশমের মতো"],["ٱلۡمَنفُوشِ","fluffed up","l-manfūshi",4747,"الْمَنْفُوْشِ ۟ؕ","ধুনিত"]]},{"v":6,"en":"Then as for one whose scales are heavy [with good deeds]","bn":"অতএব যার পাল্লা ভারী হবে","w":[["فَأَمَّا","Then as for","fa-ammā",210,"فَاَمَّا","অতঃপর তার (ব্যাপার)"],["مَن","(him) whose","man",14,"مَنْ","যার"],["ثَقُلَتۡ","(are) heavy","thaqulat",1558,"ثَقُلَتْ","ভারী হবে"],["مَوَٰزِينُهُۥ","his scales","mawāzīnuhu",597,"مَوَازِیْنُهٗ ۟ۙ","তার (পূণ্যের) পাল্লাসমূহ"]]},{"v":7,"en":"He will be in a pleasant life","bn":"সে সুখীজীবন যাপন করবে।","w":[["فَهُوَ","Then he","fahuwa",10,"فَهُوَ","সে অতঃপর থাকবে"],["فِي","(will be) in","fī",3,"فِیْ","মধ্যে"],["عِيشَةٖ","a life","ʿīshatin",2782,"عِیْشَةٍ","জীবনের"],["رَّاضِيَةٖ","pleasant","rāḍiyatin",1682,"رَّاضِیَةٍ ۟ؕ","সন্তোষজনক"]]},{"v":8,"en":"But as for one whose scales are light","bn":"আর যার পাল্লা হালকা হবে","w":[["وَأَمَّا","But as for","wa-ammā",210,"وَاَمَّا","আর (তার) ব্যাপার"],["مَنۡ","(him) whose","man",14,"مَنْ","যার"],["خَفَّتۡ","(are) light","khaffat",1867,"خَفَّتْ","হালকা হবে"],["مَوَٰزِينُهُۥ","his scales","mawāzīnuhu",597,"مَوَازِیْنُهٗ ۟ۙ","তার পাল্লাসমূহ নেকীর"]]},{"v":9,"en":"His refuge will be an abyss","bn":"তার ঠিকানা হবে হাবিয়া।","w":[["فَأُمُّهُۥ","His abode","fa-ummuhu",330,"فَاُمُّهٗ","অতঃপর তার বাসস্থান"],["هَاوِيَةࣱ","(will be the) Pit","hāwiyatun",4748,"هَاوِیَةٌ ۟ؕ","গভীর গর্ত হবে"]]},{"v":10,"en":"And what can make you know what that is","bn":"আপনি জানেন তা কি","w":[["وَمَآ","And what","wamā",2,"وَمَاۤ","এবং কিসে"],["أَدۡرَىٰكَ","will make you know","adrāka",571,"اَدْرٰىكَ","তোমাকে জানাবে"],["مَا","what","mā",2,"مَا","কি"],["هِيَهۡ","it is","hiyah",58,"هِیَهْ ۟ؕ","সেটা"]]},{"v":11,"en":"It is a Fire, intensely hot","bn":"প্রজ্জ্বলিত অগ্নি","w":[["نَارٌ","A Fire","nārun",80,"نَارٌ","(সেটা হলো) আগুন"],["حَامِيَةُۢ","intensely hot","ḥāmiyatun",2810,"حَامِیَةٌ ۟۠","গণগণে"]]}]}