l; we have believed in Him, and upon Him we have relied. And you will [come to] know who it is that is in clear error","bn":"বলুন, তিনি পরম করুণাময়, আমরা তাতে বিশ্বাস রাখি এবং তাঁরই উপর ভরসা করি। সত্ত্বরই তোমরা জানতে পারবে, কে প্রকাশ্য পথ-ভ্রষ্টতায় আছে।","w":[["قُلۡ","Say","qul",6,"قُلْ","বল"],["هُوَ","He","huwa",10,"هُوَ","\"তিনিই"],["ٱلرَّحۡمَٰنُ","(is) the Most Gracious","l-raḥmānu",199,"الرَّحْمٰنُ","পরম করুণাময়"],["ءَامَنَّا","we believe","āmannā",19,"اٰمَنَّا","আমরা ঈমান এনেছি"],["بِهِۦ","in Him","bihi",10,"بِهٖ","তার উপর"],["وَعَلَيۡهِ","and upon Him","waʿalayhi",8,"وَعَلَیْهِ","এবং তার উপর"],["تَوَكَّلۡنَاۖ","we put (our) trust","tawakkalnā",287,"تَوَكَّلْنَا ۚ","আমরা নির্ভর করেছি"],["فَسَتَعۡلَمُونَ","So you will know","fasataʿlamūna",27,"فَسَتَعْلَمُوْنَ","অতএব শীঘ্রই তোমরা জানতে পারবে"],["مَنۡ","who","man",14,"مَنْ","কে"],["هُوَ","(is) it","huwa",10,"هُوَ","সে"],["فِي","(that is) in","fī",3,"فِیْ","মধ্যে"],["ضَلَٰلٖ","error","ḍalālin",302,"ضَلٰلٍ","গুমরাহীর"],["مُّبِينٖ","clear","mubīnin",99,"مُّبِیْنٍ ۟","সুস্পষ্ট\""]]},{"v":30,"en":"Say, \"Have you considered: if your water was to become sunken [into the earth], then who could bring you flowing water","bn":"বলুন, তোমরা ভেবে দেখেছ কি, যদি তোমাদের পানি ভূগর্ভের গভীরে চলে যায়, তবে কে তোমাদেরকে সরবরাহ করবে পানির স্রোতধারা","w":[["قُلۡ","Say","qul",6,"قُلْ","বলো"],["أَرَءَيۡتُمۡ","Have you seen","ara-aytum",44,"اَرَءَیْتُمْ","\"তোমরা ভেবে কি দেখেছ"],["إِنۡ","if","in",16,"اِنْ","যদি"],["أَصۡبَحَ","becomes","aṣbaḥa",385,"اَصْبَحَ","হয়ে যায়"],["مَآؤُكُمۡ","your water","māukum",183,"مَآؤُكُمْ","তোমাদের পানি"],["غَوۡرٗا","sunken","ghawran",2519,"غَوْرًا","ভূগর্ভস্থ"],["فَمَن","then who","faman",14,"فَمَنْ","কে তবে"],["يَأۡتِيكُم","could bring you","yatīkum",46,"یَّاْتِیْكُمْ","তোমাদের কাছে আনবে"],["بِمَآءٖ","water","bimāin",183,"بِمَآءٍ","পানি"],["مَّعِينِۭ","flowing","maʿīnin",1651,"مَّعِیْنٍ ۟۠","প্রবহমান\""]]}]}