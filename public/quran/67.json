ed","kadhaba",62,"كَذَّبَ","মিথ্যারোপ"],["ٱلَّذِينَ","those","alladhīna",7,"الَّذِیْنَ","যারা"],["مِن","from","min",0,"مِنْ","(ছিল)"],["قَبۡلِهِمۡ","before them","qablihim",49,"قَبْلِهِمْ","তাদের পূর্বে"],["فَكَيۡفَ","and how","fakayfa",131,"فَكَیْفَ","কেমন ফলে"],["كَانَ","was","kāna",9,"كَانَ","ছিল"],["نَكِيرِ","My rejection","nakīri",1424,"نَكِیْرِ ۟","আমার পাক্‌ড়াও"]]},{"v":19,"en":"Do they not see the birds above them with wings outspread and [sometimes] folded in? None holds them [aloft] except the Most Merciful. Indeed He is, of all things, Seeing","bn":"তারা কি লক্ষ্য করে না, তাদের মাথার উপর উড়ন্ত পক্ষীকুলের প্রতি পাখা বিস্তারকারী ও পাখা সংকোচনকারী? রহমান আল্লাহ-ই তাদেরকে স্থির রাখেন। তিনি সর্ব-বিষয় দেখেন।","w":[["أَوَلَمۡ","Do not","awalam",31,"اَوَلَمْ","কি নাই"],["يَرَوۡاْ","they see","yaraw",44,"یَرَوْا","তারা দেখে"],["إِلَى","[to]","ilā",15,"اِلَی","প্রতি"],["ٱلطَّيۡرِ","the birds","l-ṭayri",515,"الطَّیْرِ","পাখিগুলির"],["فَوۡقَهُمۡ","above them","fawqahum",271,"فَوْقَهُمْ","তাদের উপরে"],["صَـٰٓفَّـٰتٖ","spreading (their wings)","ṣāffātin",2034,"صٰٓفّٰتٍ","পাখা বিস্তার করে"],["وَيَقۡبِضۡنَۚ","and folding","wayaqbiḍ'na",1278,"وَّیَقْبِضْنَ ؔؕۘ","ও গুটিয়ে নেয়"],["مَا","Not","mā",2,"مَا","না"],["يُمۡسِكُهُنَّ","holds them","yum'sikuhunna",531,"یُمْسِكُهُنَّ","তাদের ধরে ধরে (অন্য কেউ)"],["إِلَّا","except","illā",17,"اِلَّا","ছাড়া"],["ٱلرَّحۡمَٰنُۚ","the Most Gracious","l-raḥmānu",199,"الرَّحْمٰنُ ؕ","দয়াবান"],["إِنَّهُۥ","Indeed, He","innahu",5,"اِنَّهٗ","তিনি নিশ্চয়"],["بِكُلِّ","(is) of every","bikulli",30,"بِكُلِّ","সব উপর"],["شَيۡءِۭ","thing","shayin",39,"شَیْءٍ","কিছুর"],["بَصِيرٌ","All-Seer","baṣīrun",223,"بَصِیْرٌ ۟","দৃষ্টিবান"]]},{"v":20,"en":"Or who is it that could be an army for you to aid you other than the Most Merciful? The disbelievers are not but in delusion","bn":"রহমান আল্লাহ তা’আলা ব্যতীত তোমাদের কোন সৈন্য আছে কি, যে তোমাদেরকে সাহায্য করবে? কাফেররা বিভ্রান্তিতেই পতিত আছে।","w":[["أَمَّنۡ","Who is","amman",85,"اَمَّنْ","অথবা 