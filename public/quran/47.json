্ছে করি"],["لَأَرَيۡنَٰكَهُمۡ","surely, We could show them to you","la-araynākahum",280,"لَاَرَیْنٰكَهُمْ","আমরা অবশ্যই তাদের দেখাতে পারি"],["فَلَعَرَفۡتَهُم","and you would know them","falaʿaraftahum",490,"فَلَعَرَفْتَهُمْ","তুমি তখন তাদের চিনবেই"],["بِسِيمَٰهُمۡۚ","by their marks","bisīmāhum",1155,"بِسِیْمٰهُمْ ؕ","দ্বারা তাদের লক্ষণগুলো"],["وَلَتَعۡرِفَنَّهُمۡ","but surely, you will know them","walataʿrifannahum",490,"وَلَتَعْرِفَنَّهُمْ","এবং তাদেরকে তুমি অবশ্যই চিনবে"],["فِي","by","fī",3,"فِیْ","আছে"],["لَحۡنِ","(the) tone","laḥni",4183,"لَحْنِ","ভংগিতে"],["ٱلۡقَوۡلِۚ","(of their) speech","l-qawli",116,"الْقَوْلِ ؕ","কথা (বলার)"],["وَٱللَّهُ","And Allah","wal-lahu",1,"وَاللّٰهُ","এবং আল্লাহ্‌ই"],["يَعۡلَمُ","knows","yaʿlamu",27,"یَعْلَمُ","জানেন"],["أَعۡمَٰلَكُمۡ","your deeds","aʿmālakum",164,"اَعْمَالَكُمْ ۟","তোমাদের কর্মসমূহকে"]]},{"v":31,"en":"And We will surely test you until We make evident those who strive among you [for the cause of Allah] and the patient, and We will test your affairs","bn":"আমি অবশ্যই তোমাদেরকে পরীক্ষা করব যে পর্যন্ত না ফুটিয়ে তুলি তোমাদের জেহাদকারীদেরকে এবং সবরকারীদেরকে এবং যতক্ষণ না আমি তোমাদের অবস্থান সমূহ যাচাই করি।","w":[["وَلَنَبۡلُوَنَّكُمۡ","And surely We will test you","walanabluwannakum",495,"وَلَنَبْلُوَنَّكُمْ","এবং তোমাদের পরীক্ষা করব  আমরা অবশ্যই"],["حَتَّىٰ","until","ḥattā",83,"حَتّٰی","যতক্ষণ না"],["نَعۡلَمَ","We make evident","naʿlama",27,"نَعْلَمَ","আমরা জানবো"],["ٱلۡمُجَٰهِدِينَ","those who strive","l-mujāhidīna",1519,"الْمُجٰهِدِیْنَ","মুজাহিদদেরকে"],["مِنكُمۡ","among you","minkum",0,"مِنْكُمْ","তোমাদের মধ্যকার"],["وَٱلصَّـٰبِرِينَ","and the patient ones","wal-ṣābirīna",494,"وَالصّٰبِرِیْنَ ۙ","ও ধৈর্যশীলদেরকে"],["وَنَبۡلُوَاْ","and We will test","wanabluwā",495,"وَنَبْلُوَاۡ","এবং আমরা পরীক্ষা করবো"],["أَخۡبَارَكُمۡ","your affairs","akhbārakum",1914,"اَخْبَارَكُمْ ۟","তোমাদের খবরাদি"]]},{"v":32,"en":"Indeed, those who disbelieved and averted [people] from the path of Allah and opposed the Messenger after guidance had become clear to them - never will they harm Allah at all, and He will render worthless their deeds","bn":"নিশ্চয় যারা কাফের এবং আল্লাহর পথ থেকে মানুষকে ফিরিয়ে রাখে এবং নিজেদের জন্যে সৎপথ ব্যক্ত হওয়ার পর রসূলের (সঃ) বিরোধিতা করে, তারা আল্লাহর কোনই ক্ষতি করতে পারবে না এবং তিনি ব্যর্থ করে দিবেন তাদের কর্মসমূহকে।","w":[["إِنَّ","Indeed","inna",5,"اِنَّ","নিশ্চয়ই"],["ٱلَّذِينَ","those who","alladhīna",7,"الَّذِیْنَ","যারা"],["كَفَرُواْ","disbelieve","kafarū",38,"كَفَرُوْا","অস্বীকার করেছে"],["وَصَدُّواْ","and turn away","waṣaddū",311,"وَصَدُّوْا","ও বাধা দিয়েছে (লোকদেরকে)"],["عَن","from","ʿan",22,"عَنْ","হতে"],["سَبِيلِ","(the) way of Allah","sabīli",63,"سَبِیْلِ","পথ"],["ٱللَّهِ","(the) way of Allah","l-lahi",1,"اللّٰهِ","আল্লাহ্‌র"],["وَشَآقُّواْ","and oppose","washāqqū",1071,"وَشَآقُّوا","এবং বিরোধিতা করেছে"],["ٱلرَّسُولَ","the Messenger","l-rasūla",34,"الرَّسُوْلَ","রাসুলের"],["مِنۢ","after","min",0,"مِنْ","মধ্য হতে"],["بَعۡدِ","after","baʿdi",56,"بَعْدِ","এরপরেও"],["مَا","[what]","mā",2,"مَا","যা"],["تَبَيَّنَ","(has been) made clear","tabayyana",526,"تَبَیَّنَ","সুস্পষ্ট হয়েছে"],["لَهُمُ","to them","lahumu",13,"لَهُمُ","তাদের কাছে"],["ٱلۡهُدَىٰ","the guidance","l-hudā",126,"الْهُدٰی ۙ","(অর্থাৎ) সৎপথ"],["لَن","never","lan",109,"لَنْ","কখনও না"],["يَضُرُّواْ","will they harm","yaḍurrū",512,"یَّضُرُّوا","তারা ক্ষতি করতে পারবে"],["ٱللَّهَ","Allah","l-laha",1,"اللّٰهَ","আল্লাহকে"],["شَيۡـٔٗا","(in) anything","shayan",39,"شَیْـًٔا ؕ","কিছুমাত্রও"],["وَسَيُحۡبِطُ","and He will make worthless","wasayuḥ'biṭu",1666,"وَسَیُحْبِطُ","এবং অচিরেই তিনি বিনষ্ট করে দিবেন"],["أَعۡمَٰلَهُمۡ","their deeds","aʿmālahum",164,"اَعْمَالَهُمْ ۟","তাদের কর্মসমূহকে"]]},{"v":33,"en":"O you who have believed, obey Allah and obey the Messenger and do not invalidate your deeds","bn":"হে মুমিনগণ! তোমরা আল্লাহর আনুগত্য কর, রসূলের (সাঃ) আনুগত্য কর এবং নিজেদের কর্ম বিনষ্ট করো না।","w":[["۞يَـٰٓأَيُّهَا","O you who believe","yāayyuhā",53,"یٰۤاَیُّهَا","হে"],["ٱلَّذِينَ","O you who believe","alladhīna",7,"الَّذِیْنَ","যারা"],["ءَامَنُوٓاْ","O you who believe","āmanū",19,"اٰمَنُوْۤا","ঈমান এনেছ"],["أَطِيعُواْ","Obey","aṭīʿū",159,"اَطِیْعُوا","তোমরা আনুগত্য করো"],["ٱللَّهَ","Allah","l-laha",1,"اللّٰهَ","আল্লাহ্‌র"],["وَأَطِيعُواْ","and obey","wa-aṭīʿū",159,"وَاَطِیْعُوا","ও আনুগত্য করো"],["ٱلرَّسُولَ","the Messenger","l-rasūla",34,"الرَّسُوْلَ","রাসুলের"],["وَلَا","and (do) not","walā",4,"وَلَا","এবং না"],["تُبۡطِلُوٓاْ","make vain","tub'ṭilū",1477,"تُبْطِلُوْۤا","তোমরা বিনষ্ট করো"],["أَعۡمَٰلَكُمۡ","your deeds","aʿmālakum",164,"اَعْمَالَكُمْ ۟","তোমাদের কর্মসমূহকে"]]},{"v":34,"en":"Indeed, those who disbelieved and averted [people] from the path of Allah and then died while they were disbelievers - never will Allah forgive them","bn":"নিশ্চয় যারা কাফের এবং আল্লাহর পথ থেকে মানুষকে ফিরিয়ে রাখে, অতঃপর কাফের অবস্থায় মারা যায়, আল্লাহ কখনই তাদেরকে ক্ষমা করবেন না।","w":[["إِنَّ","Indeed","inna",5,"اِنَّ","নিশ্চয়ই"],["ٱلَّذِينَ","those who","alladhīna",7,"الَّذِیْنَ","যারা"],["كَفَرُواْ","disbelieve","kafarū",38,"كَفَرُوْا","অস্বীকার করেছে"],["وَصَدُّواْ","and turn away","waṣaddū",311,"وَصَدُّوْا","ও বাধা দিয়েছে (লোকদেরকে)"],["عَن","from","ʿan",22,"عَنْ","হতে"],["سَبِيلِ","(the) way","sabīli",63,"سَبِیْلِ","পথ"],["ٱللَّهِ","(of) Allah","l-lahi",1,"اللّٰهِ","আল্লাহ্‌র"],["ثُمَّ","then","thumma",33,"ثُمَّ","তারপর"],["مَاتُواْ","died","mātū",293,"مَاتُوْا","তারা মারা গেছে"],["وَهُمۡ","while they","wahum",13,"وَهُمْ","এমতাবস্থায় যে"],["كُفَّارࣱ","(were) disbelievers","kuffārun",73,"كُفَّارٌ","কাফের (ছিল)"],["فَلَن","never","falan",109,"فَلَنْ","ফলে কখনও না"],["يَغۡفِرَ","will Allah forgive","yaghfira",174,"یَّغْفِرَ","ক্ষমা করবেন"],["ٱللَّهُ","will Allah forgive","l-lahu",1,"اللّٰهُ","আল্লাহ্‌"],["لَهُمۡ","them","lahum",13,"لَهُمْ ۟","তাদেরকে"]]},{"v":35,"en":"So do not weaken and call for peace while you are superior; and Allah is with you and will never deprive you of [the reward of] your deeds","bn":"অতএব, তোমরা হীনবল হয়ো না এবং সন্ধির আহবান জানিও না, তোমরাই হবে প্রবল। আল্লাহই তোমাদের সাথে আছেন। তিনি কখনও তোমাদের কর্ম হ্রাস করবেন না।","w":[["فَلَا","So (do) not","falā",4,"فَلَا","অতএব না"],["تَهِنُواْ","weaken","tahinū",1308,"تَهِنُوْا","তোমরা সাহস হারিয়ো না"],["وَتَدۡعُوٓاْ","and call","watadʿū",65,"وَتَدْعُوْۤا","এবং তোমরা আহবান করো (না)"],["إِلَى","for","ilā",15,"اِلَی","দিকে"],["ٱلسَّلۡمِ","peace","l-salmi",2360,"السَّلْمِ ۖۗ","সন্ধির"],["وَأَنتُمُ","while you","wa-antumu",20,"وَاَنْتُمُ","এবং তোমরাই (হবে)"],["ٱلۡأَعۡلَوۡنَ","(are) superior","l-aʿlawna",2203,"الْاَعْلَوْنَ ۖۗ","বিজয়ী"],["وَٱللَّهُ","and Allah","wal-lahu",1,"وَاللّٰهُ","এবং আল্লাহ্‌"],["مَعَكُمۡ","(is) with you","maʿakum",69,"مَعَكُمْ","তোমাদের সাথে (আছেন)"],["وَلَن","and never","walan",109,"وَلَنْ","এবং কখনও না"],["يَتِرَكُمۡ","will deprive you","yatirakum",4184,"یَّتِرَكُمْ","তোমাদের কমাবেন"],["أَعۡمَٰلَكُمۡ","(of) your deeds","aʿmālakum",164,"اَعْمَالَكُمْ ۟","তোমাদের কর্মসমূহকে"]]},{"v":36,"en":"[This] worldly life is only amusement and diversion. And if you believe and fear Allah, He will give you your rewards and not ask you for your properties","bn":"পার্থিব জীবন তো কেবল খেলাধুলা, যদি তোমরা বিশ্বাসী হও এবং সংযম অবলম্বন কর, আল্লাহ তোমাদেরকে তোমাদের প্রতিদান দেবেন এবং তিনি তোমাদের ধন-সম্পদ চাইবেন না।","w":[["إِنَّمَا","Only","innamā",5,"اِنَّمَا","প্রকৃতপক্ষে"],["ٱلۡحَيَوٰةُ","the life","l-ḥayatu",145,"الْحَیٰوةُ","জীবন"],["ٱلدُّنۡيَا","(of) the world","l-dun'yā",101,"الدُّنْیَا","পার্থিব"],["لَعِبࣱ","(is) play","laʿibun",982,"لَعِبٌ","খেলা"],["وَلَهۡوࣱۚ","and amusement","walahwun",843,"وَّلَهْوٌ ؕ","ও তামাশা (মাত্র)"],["وَإِن","And if","wa-in",16,"وَاِنْ","এবং যদি"],["تُؤۡمِنُواْ","you believe","tu'minū",19,"تُؤْمِنُوْا","তোমরা ঈমান আন"],["وَتَتَّقُواْ","and fear (Allah)","watattaqū",66,"وَتَتَّقُوْا","ও তোমরা ভয় করে চল"],["يُؤۡتِكُمۡ","He will give you","yu'tikum",43,"یُؤْتِكُمْ","তিনি তোমাদের দান করবেন"],["أُجُورَكُمۡ","your rewards","ujūrakum",108,"اُجُوْرَكُمْ","তোমাদের কর্মফলসমূহকে"],["وَلَا","and not","walā",4,"وَلَا","এবং না"],["يَسۡـَٔلۡكُمۡ","will ask you","yasalkum",105,"یَسْـَٔلْكُمْ","তোমাদের থেকে তিনি চান"],["أَمۡوَٰلَكُمۡ","(for) your wealth","amwālakum",125,"اَمْوَالَكُمْ ۟","তোমাদের সম্পদগুলোকে"]]},{"v":37,"en":"If He should ask you for them and press you, you would withhold, and He would expose your unwillingness","bn":"তিনি তোমাদের কাছে ধন-সম্পদ চাইলে অতঃপর তোমাদেরকে অতিষ্ঠ করলে তোমরা কার্পণ্য করবে এবং তিনি তোমাদের মনের সংকীর্ণতা প্রকাশ করে দেবেন।","w":[["إِن","If","in",16,"اِنْ","যদি"],["يَسۡـَٔلۡكُمُوهَا","He were to ask you for it","yasalkumūhā",105,"یَّسْـَٔلْكُمُوْهَا","তা তোমাদের থেকে চান তিনি"],["فَيُحۡفِكُمۡ","and press you","fayuḥ'fikum",4185,"فَیُحْفِكُمْ","অতঃপর তোমাদেরকে  চাপ দেন"],["تَبۡخَلُواْ","you will withhold","tabkhalū",836,"تَبْخَلُوْا","তোমরা কৃপণতা করবে"],["وَيُخۡرِجۡ","and He will bring forth","wayukh'rij",111,"وَیُخْرِجْ","এবং তিনি প্রকাশ করবেন"],["أَضۡغَٰنَكُمۡ","your hatred","aḍghānakum",2728,"اَضْغَانَكُمْ ۟","তোমাদের গোপন ত্রুটিকে"]]},{"v":38,"en":"Here you are - those invited to spend in the cause of Allah - but among you are those who withhold [out of greed]. And whoever withholds only withholds [benefit] from himself; and Allah is the Free of need, while you are the needy. And if you turn away, He will replace you with another people; then they will not be the likes of you","bn":"শুন, তোমরাই তো তারা, যাদেরকে আল্লাহর পথে ব্যয় করার আহবান জানানো হচ্ছে, অতঃপর তোমাদের কেউ কেউ কৃপণতা করছে। যারা কৃপণতা করছে, তারা নিজেদের প্রতিই কৃপণতা করছে। আল্লাহ অভাবমুক্ত এবং তোমরা অভাবগ্রস্থ। যদি তোমরা মুখ ফিরিয়ে নাও, তবে তিনি তোমাদের পরিবর্তে অন্য জাতিকে প্রতিষ্ঠিত করবেন, এরপর তারা তোমাদের মত হবে না।","w":[["هَـٰٓأَنتُمۡ","Here you are","hāantum",20,"هٰۤاَنْتُمْ","তোমরা দেখ"],["هَـٰٓؤُلَآءِ","these","hāulāi",11,"هٰۤؤُلَآءِ","ঐসব লোক (যাদের)"],["تُدۡعَوۡنَ","called","tud'ʿawna",65,"تُدْعَوْنَ","আহবান করা হচ্ছে"],["لِتُنفِقُواْ","to spend","litunfiqū",172,"لِتُنْفِقُوْا","তোমরা খরচ কর যেন"],["فِي","in","fī",3,"فِیْ","মধ্যে"],["سَبِيلِ","(the) way","sabīli",63,"سَبِیْلِ","পথের"],["ٱللَّهِ","(of) Allah","l-lahi",1,"اللّٰهِ ۚ","আল্লাহ্‌র"],["فَمِنكُم","but among you","faminkum",0,"فَمِنْكُمْ","তখন তোমাদের মধ্য হতে"],["مَّن","(are some) who","man",14,"مَّنْ","কেউ কেউ"],["يَبۡخَلُۖ","withhold","yabkhalu",836,"یَّبْخَلُ ۚ","কৃপণতা করে"],["وَمَن","and whoever","waman",14,"وَمَنْ","অথচ যে"],["يَبۡخَلۡ","withholds","yabkhal",836,"یَّبْخَلْ","কৃপণতা করে"],["فَإِنَّمَا","then only","fa-innamā",5,"فَاِنَّمَا","প্রকৃতপক্ষে"],["يَبۡخَلُ","he withholds","yabkhalu",836,"یَبْخَلُ","সে কৃপণতা করে"],["عَن","from","ʿan",22,"عَنْ","প্রতি"],["نَّفۡسِهِۦۚ","himself","nafsihi",37,"نَّفْسِهٖ ؕ","তার নিজের"],["وَٱللَّهُ","But Allah","wal-lahu",1,"وَاللّٰهُ","এবং আলাহ"],["ٱلۡغَنِيُّ","(is) Free of need","l-ghaniyu",433,"الْغَنِیُّ","অভাবমুক্ত"],["وَأَنتُمُ","while you","wa-antumu",20,"وَاَنْتُمُ","কিন্তু তোমরা"],["ٱلۡفُقَرَآءُۚ","(are) the needy","l-fuqarāu",714,"الْفُقَرَآءُ ۚ","অভাবগ্রস্ত"],["وَإِن","And if","wa-in",16,"وَاِنْ","আর যদি"],["تَتَوَلَّوۡاْ","you turn away","tatawallaw",139,"تَتَوَلَّوْا","তোমরা মুখ ফিরাও (তবে)"],["يَسۡتَبۡدِلۡ","He will replace you","yastabdil",1695,"یَسْتَبْدِلْ","তিনি পরিবর্তন করে আনবেন"],["قَوۡمًا","(with) a people","qawman",26,"قَوْمًا","(অন্য এক) জাতিকে"],["غَيۡرَكُمۡ","other than you","ghayrakum",76,"غَیْرَكُمْ ۙ","তোমাদের ব্যতীত"],["ثُمَّ","then","thumma",33,"ثُمَّ","এরপর"],["لَا","not","lā",4,"لَا","না"],["يَكُونُوٓاْ","they will be","yakūnū",9,"یَكُوْنُوْۤا","তারা হবে"],["أَمۡثَٰلَكُم","(the) likes of you","amthālakum",120,"اَمْثَالَكُمْ ۟۠","তোমাদের মতো"]]}]}