{"n":94,"verses":[{"v":1,"en":"Did We not expand for you, [O Muhammad], your breast","bn":"আমি কি আপনার বক্ষ উম্মুক্ত করে দেইনি","w":[["أَلَمۡ","Have not","alam",31,"اَلَمْ","করি দিই নি?"],["نَشۡرَحۡ","We expanded","nashraḥ",1348,"نَشْرَحْ","আমরা উন্মুক্ত"],["لَكَ","for you","laka",71,"لَكَ","তোমার জন্যে"],["صَدۡرَكَ","your breast","ṣadraka",257,"صَدْرَكَ ۟ۙ","তোমার বক্ষকে"]]},{"v":2,"en":"And We removed from you your burden","bn":"আমি লাঘব করেছি আপনার বোঝা","w":[["وَوَضَعۡنَا","And We removed","wawaḍaʿnā",484,"وَوَضَعْنَا","এবং আমরা নামিয়েছি"],["عَنكَ","from you","ʿanka",22,"عَنْكَ","তোমার থেকে"],["وِزۡرَكَ","your burden","wiz'raka",730,"وِزْرَكَ ۟ۙ","তোমার ভার"]]},{"v":3,"en":"Which had weighed upon your back","bn":"যা ছিল আপনার জন্যে অতিশয় দুঃসহ।","w":[["ٱلَّذِيٓ","Which","alladhī",7,"الَّذِیْۤ","যা"],["أَنقَضَ","weighed upon","anqaḍa",4725,"اَنْقَضَ","ভেঙ্গে দিচ্ছিলো"],["ظَهۡرَكَ","your back","ẓahraka",609,"ظَهْرَكَ ۟ۙ","তোমার পিঠ"]]},{"v":4,"en":"And raised high for you your repute","bn":"আমি আপনার আলোচনাকে সমুচ্চ করেছি।","w":[["وَرَفَعۡنَا","And We raised high","warafaʿnā",453,"وَرَفَعْنَا","ও আমরা সুউচ্চ করেছি"],["لَكَ","for you","laka",71,"لَكَ","তোমার জন্যে"],["ذِكۡرَكَ","your reputation","dhik'raka",146,"ذِكْرَكَ ۟ؕ","তোমার খ্যাতি/ স্মরণকে"]]},{"v":5,"en":"For indeed, with hardship [will be] ease","bn":"নিশ্চয় কষ্টের সাথে স্বস্তি রয়েছে।","w":[["فَإِنَّ","So indeed","fa-inna",5,"فَاِنَّ","অতএব নিশ্চয়ই"],["مَعَ","with","maʿa",69,"مَعَ","সাথে"],["ٱلۡعُسۡرِ","the hardship","l-ʿus'ri",1270,"الْعُسْرِ","কষ্টের"],["يُسۡرًا","(is) ease","yus'ran",1034,"یُسْرًا ۟ۙ","স্বস্তি (আছে)"]]},{"v":6,"en":"Indeed, with hardship [will be] ease","bn":"নিশ্চয় কষ্টের সাথে স্বস্তি রয়েছে।","w":[["إِنَّ","Indeed","inna",5,"اِنَّ","নিশ্চয়ই"],["مَعَ","with","maʿa",69,"مَعَ","সাথে"],["ٱلۡعُسۡرِ","the hardship","l-ʿus'ri",1270,"الْعُسْرِ","কষ্টের"],["يُسۡرٗا","(is) ease","yus'ran",1034,"یُسْرًا ۟ؕ","স্বস্তি (আছে)"]]},{"v":7,"en":"So when you have finished [your duties], then stand up [for worship]","bn":"অতএব, যখন অবসর পান পরিশ্রম করুন।","w":[["فَإِذَا","So when","fa-idhā",24,"فَاِذَا","অতএব যখনই"],["فَرَغۡتَ","you have finished","faraghta",2760,"فَرَغْتَ","তুমি অবসর হও"],["فَٱنصَبۡ","then labor hard","fa-inṣab",2811,"فَانْصَبْ ۟ۙ","তুমি তখন ইবাদাত করো"]]},{"v":8,"en":"And to your Lord direct [your] longing","bn":"এবং আপনার পালনকর্তার প্রতি মনোনিবেশ করুন।","w":[["وَإِلَىٰ","And to","wa-ilā",15,"وَاِلٰی","এবং প্রতি"],["رَبِّكَ","your Lord","rabbika",12,"رَبِّكَ","তোমার রবের"],["فَٱرۡغَب","turn your attention","fa-ir'ghab",1457,"فَارْغَبْ ۟۠","তখন মনোনিবেশ করো"]]}]}