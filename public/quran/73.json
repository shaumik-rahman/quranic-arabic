"],["عِندَ","with","ʿinda",57,"","কাছে"],["ٱللَّهِ","Allah","l-lahi",1,"","আল্লাহ্‌র"],["هُوَ","It","huwa",10,"","তাই"],["خَيۡرٗا","(will be) better","khayran",61,"","উত্তম"],["وَأَعۡظَمَ","and greater","wa-aʿẓama",1900,"","এবং অতীব উত্তম"],["أَجۡرٗاۚ","(in) reward","ajran",108,"","প্রতিফল"],["وَٱسۡتَغۡفِرُواْ","And seek forgiveness","wa-is'taghfirū",285,"","এবং তোমরা ক্ষমা চাও"],["ٱللَّهَۖ","(of) Allah","l-laha",1,"","আল্লাহ্‌র কাছে"],["إِنَّ","Indeed","inna",5,"","নিশ্চয়"],["ٱللَّهَ","Allah","l-laha",1,"","আল্লাহ্‌"],["غَفُورࣱ","(is) Oft-Forgiving","ghafūrun",117,"","বড় ক্ষমাশীল"],["رَّحِيمُۢ","Most Merciful","raḥīmun",100,"","অত্যন্ত মেহেরবান"]]}]}