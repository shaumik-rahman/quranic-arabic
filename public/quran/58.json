212,"الْاَنْهٰرُ","ঝর্ণাধারা সমূহ"],["خَٰلِدِينَ","will abide forever","khālidīna",151,"خٰلِدِیْنَ","তারা চিরকাল থাকবে"],["فِيهَاۚ","in it","fīhā",3,"فِیْهَا ؕ","তার মধ্যে"],["رَضِيَ","Allah is pleased","raḍiya",300,"رَضِیَ","সন্তুষ্ট/ প্রসন্ন হয়েছেন"],["ٱللَّهُ","Allah is pleased","l-lahu",1,"اللّٰهُ","আল্লাহ"],["عَنۡهُمۡ","with them","ʿanhum",22,"عَنْهُمْ","তাদের প্রতি"],["وَرَضُواْ","and they are pleased","waraḍū",300,"وَرَضُوْا","ও তারা সন্তুষ্ট হয়েছে"],["عَنۡهُۚ","with Him","ʿanhu",22,"عَنْهُ ؕ","তাঁর প্রতি"],["أُوْلَـٰٓئِكَ","Those","ulāika",11,"اُولٰٓىِٕكَ","ঐসব লোক(অন্তর্ভুক্ত)"],["حِزۡبُ","(are the) party","ḥiz'bu",504,"حِزْبُ","দলের"],["ٱللَّهِۚ","(of) Allah","l-lahi",1,"اللّٰهِ ؕ","আল্লাহর"],["أَلَآ","No doubt","alā",290,"اَلَاۤ","জেনে রাখ"],["إِنَّ","Indeed","inna",5,"اِنَّ","নিশ্চয়ই"],["حِزۡبَ","(the) party","ḥiz'ba",504,"حِزْبَ","দল"],["ٱللَّهِ","(of) Allah","l-lahi",1,"اللّٰهِ","আল্লাহর"],["هُمُ","they","humu",13,"هُمُ","তারাই"],["ٱلۡمُفۡلِحُونَ","(are) the successful ones","l-muf'liḥūna",662,"الْمُفْلِحُوْنَ ۟۠","সফলকাম"]]}]}