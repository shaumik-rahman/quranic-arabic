{"n":96,"verses":[{"v":1,"en":"Recite in the name of your Lord who created","bn":"পাঠ করুন আপনার পালনকর্তার নামে যিনি সৃষ্টি করেছেন","w":[["ٱقۡرَأۡ","Read","iq'ra",598,"اِقْرَاْ"],["بِٱسۡمِ","in (the) name","bi-is'mi",289,"بِاسْمِ"],["رَبِّكَ","(of) your Lord","rabbika",12,"رَبِّكَ"],["ٱلَّذِي","the One Who","alladhī",7,"الَّذِیْ"],["خَلَقَ","created","khalaqa",59,"خَلَقَ ۟ۚ"]]},{"v":2,"en":"Created man from a clinging substance","bn":"সৃষ্টি করেছেন মানুষকে জমাট রক্ত থেকে।","w":[["خَلَقَ","He created","khalaqa",59,"خَلَقَ"],["ٱلۡإِنسَٰنَ","man","l-insāna",161,"الْاِنْسَانَ"],["مِنۡ","from","min",0,"مِنْ"],["عَلَقٍ","a clinging substance","ʿalaqin",4729,"عَلَقٍ ۟ۚ"]]},{"v":3,"en":"Recite, and your Lord is the most Generous","bn":"পাঠ করুন, আপনার পালনকর্তা মহা দয়ালু","w":[["ٱقۡرَأۡ","Read","iq'ra",598,"اِقْرَاْ"],["وَرَبُّكَ","and your Lord","warabbuka",12,"وَرَبُّكَ"],["ٱلۡأَكۡرَمُ","(is) the Most Generous","l-akramu",2732,"الْاَكْرَمُ ۟ۙ"]]},{"v":4,"en":"Who taught by the pen","bn":"যিনি কলমের সাহায্যে শিক্ষা দিয়েছেন","w":[["ٱلَّذِي","The One Who","alladhī",7,"الَّذِیْ"],["عَلَّمَ","taught","ʿallama",272,"عَلَّمَ"],["بِٱلۡقَلَمِ","by the pen","bil-qalami",1487,"بِالْقَلَمِ ۟ۙ"]]},{"v":5,"en":"Taught man that which he knew not","bn":"শিক্ষা দিয়েছেন মানুষকে যা সে জানত না।","w":[["عَلَّمَ","Taught","ʿallama",272,"عَلَّمَ"],["ٱلۡإِنسَٰنَ","man","l-insāna",161,"الْاِنْسَانَ"],["مَا","what","mā",2,"مَا"],["لَمۡ","not","lam",31,"لَمْ"],["يَعۡلَمۡ","he knew","yaʿlam",27,"یَعْلَمْ ۟ؕ"]]},{"v":6,"en":"No! [But] indeed, man transgresses","bn":"সত্যি সত্যি মানুষ সীমালংঘন করে","w":[["كَلَّآ","Nay","kallā",338,"كَلَّاۤ"],["إِنَّ","Indeed","inna",5,"اِنَّ"],["ٱلۡإِنسَٰنَ","man","l-insāna",161,"الْاِنْسَانَ"],["لَيَطۡغَىٰٓ","surely transgresses","layaṭghā",742,"لَیَطْغٰۤی ۟ۙ"]]},{"v":7,"en":"Because he sees himself self-sufficient","bn":"এ কারণে যে, সে নিজেকে অভাবমুক্ত মনে করে।","w":[["أَن","That","an",18,"اَنْ"],["رَّءَاهُ","he sees himself","raāhu",44,"رَّاٰهُ"],["ٱسۡتَغۡنَىٰٓ","self-sufficient","is'taghnā",1680,"اسْتَغْنٰی ۟ؕ"]]},{"v":8,"en":"Indeed, to your Lord is the return","bn":"নিশ্চয় আপনার পালনকর্তার দিকেই প্রত্যাবর্তন হবে।","w":[["إِنَّ","Indeed","inna",5,"اِنَّ"],["إِلَىٰ","to","ilā",15,"اِلٰی"],["رَبِّكَ","your Lord","rabbika",12,"رَبِّكَ"],["ٱلرُّجۡعَىٰٓ","(is) the return","l-ruj'ʿā",4730,"الرُّجْعٰی ۟ؕ"]]},{"v":9,"en":"Have you seen the one who forbids","bn":"আপনি কি তাকে দেখেছেন, যে নিষেধ করে","w":[["أَرَءَيۡتَ","Have you seen","ara-ayta",44,"اَرَءَیْتَ"],["ٱلَّذِي","the one who","alladhī",7,"الَّذِیْ"],["يَنۡهَىٰ","forbids","yanhā",344,"یَنْهٰی ۟ۙ"]]},{"v":10,"en":"A servant when he prays","bn":"এক বান্দাকে যখন সে নামায পড়ে","w":[["عَبۡدًا","A slave","ʿabdan",89,"عَبْدًا"],["إِذَا","when","idhā",24,"اِذَا"],["صَلَّىٰٓ","he prays","ṣallā",716,"صَلّٰی ۟ؕ"]]},{"v":11,"en":"Have you seen if he is upon guidance","bn":"আপনি কি দেখেছেন যদি সে সৎপথে থাকে।","w":[["أَرَءَيۡتَ","Have you seen","ara-ayta",44,"اَرَءَیْتَ"],["إِن","if","in",16,"اِنْ"],["كَانَ","he is","kāna",9,"كَانَ"],["عَلَى","upon","ʿalā",8,"عَلَی"],["ٱلۡهُدَىٰٓ","[the] guidance","l-hudā",126,"الْهُدٰۤی ۟ۙ"]]},{"v":12,"en":"Or enjoins righteousness","bn":"অথবা খোদাভীতি শিক্ষা দেয়।","w":[["أَوۡ","Or","aw",40,"اَوْ"],["أَمَرَ","he enjoins","amara",141,"اَمَرَ"],["بِٱلتَّقۡوَىٰٓ","[of the] righteousness","bil-taqwā",559,"بِالتَّقْوٰی ۟ؕ"]]},{"v":13,"en":"Have you seen if he denies and turns away","bn":"আপনি কি দেখেছেন, যদি সে মিথ্যারোপ করে ও মুখ ফিরিয়ে নেয়।","w":[["أَرَءَيۡتَ","Have you seen","ara-ayta",44,"اَرَءَیْتَ"],["إِن","if","in",16,"اِنْ"],["كَذَّبَ","he denies","kadhaba",62,"كَذَّبَ"],["وَتَوَلَّىٰٓ","and turns away","watawallā",139,"وَتَوَلّٰی ۟ؕ"]]},{"v":14,"en":"Does he not know that Allah sees","bn":"সে কি জানে না যে, আল্লাহ দেখেন","w":[["أَلَمۡ","Does not","alam",31,"اَلَمْ"],["يَعۡلَم","he know","yaʿlam",27,"یَعْلَمْ"],["بِأَنَّ","that","bi-anna",29,"بِاَنَّ"],["ٱللَّهَ","Allah","l-laha",1,"اللّٰهَ"],["يَرَىٰ","sees","yarā",44,"یَرٰی ۟ؕ"]]},{"v":15,"en":"No! If he does not desist, We will surely drag him by the forelock","bn":"কখনই নয়, যদি সে বিরত না হয়, তবে আমি মস্তকের সামনের কেশগুচ্ছ ধরে হেঁচড়াবই","w":[["كَلَّا","Nay","kallā",338,"كَلَّا"],["لَئِن","If","la-in",16,"لَىِٕنْ"],["لَّمۡ","not","lam",31,"لَّمْ"],["يَنتَهِ","he desists","yantahi",582,"یَنْتَهِ ۙ۬"],["لَنَسۡفَعَۢا","surely We will drag him","lanasfaʿan",4731,"لَنَسْفَعًا"],["بِٱلنَّاصِيَةِ","by the forelock","bil-nāṣiyati",1928,"بِالنَّاصِیَةِ ۟ۙ"]]},{"v":16,"en":"A lying, sinning forelock","bn":"মিথ্যাচারী, পাপীর কেশগুচ্ছ।","w":[["نَاصِيَةٖ","A forelock","nāṣiyatin",1928,"نَاصِیَةٍ"],["كَٰذِبَةٍ","lying","kādhibatin",343,"كَاذِبَةٍ"],["خَاطِئَةٖ","sinful","khāṭi-atin",2780,"خَاطِئَةٍ ۟ۚ"]]},{"v":17,"en":"Then let him call his associates","bn":"অতএব, সে তার সভাসদদেরকে আহবান করুক।","w":[["فَلۡيَدۡعُ","Then let him call","falyadʿu",65,"فَلْیَدْعُ"],["نَادِيَهُۥ","his associates","nādiyahu",2658,"نَادِیَهٗ ۟ۙ"]]},{"v":18,"en":"We will call the angels of Hell","bn":"আমিও আহবান করব জাহান্নামের প্রহরীদেরকে","w":[["سَنَدۡعُ","We will call","sanadʿu",65,"سَنَدْعُ"],["ٱلزَّبَانِيَةَ","the Angels of Hell","l-zabāniyata",4732,"الزَّبَانِیَةَ ۟ۙ"]]},{"v":19,"en":"No! Do not obey him. But prostrate and draw near [to Allah]","bn":"কখনই নয়, আপনি তার আনুগত্য করবেন না। আপনি সেজদা করুন ও আমার নৈকট্য অর্জন করুন।","w":[["كَلَّا","Nay","kallā",338,"كَلَّا ؕ"],["لَا","(Do) not","lā",4,"لَا"],["تُطِعۡهُ","obey him","tuṭiʿ'hu",159,"تُطِعْهُ"],["وَٱسۡجُدۡۤ","But prostrate","wa-us'jud",318,"وَاسْجُدْ"],["وَٱقۡتَرِب۩","and draw near (to Allah)","wa-iq'tarib",1369,"وَاقْتَرِبْ ۟"]]}]}