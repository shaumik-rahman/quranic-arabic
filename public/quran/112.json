{"n":112,"verses":[{"v":1,"en":"Say, \"He is Allah, [who is] One","bn":"বলুন, তিনি আল্লাহ, এক","w":[["قُلۡ","Say","qul",6,"قُلْ","বলো"],["هُوَ","He","huwa",10,"هُوَ","\"তিনি"],["ٱللَّهُ","(is) Allah","l-lahu",1,"اللّٰهُ","আল্লাহ"],["أَحَدٌ","the One","aḥadun",154,"اَحَدٌ ۟ۚ","এক-অদ্বিতীয়"]]},{"v":2,"en":"Allah, the Eternal Refuge","bn":"আল্লাহ অমুখাপেক্ষী","w":[["ٱللَّهُ","Allah","al-lahu",1,"اَللّٰهُ","আল্লাহ"],["ٱلصَّمَدُ","the Eternal, the Absolute","l-ṣamadu",4773,"الصَّمَدُ ۟ۚ","অমুখাপেক্ষী"]]},{"v":3,"en":"He neither begets nor is born","bn":"তিনি কাউকে জন্ম দেননি এবং কেউ তাকে জন্ম দেয়নি","w":[["لَمۡ","Not","lam",31,"لَمْ","নি"],["يَلِدۡ","He begets","yalid",922,"یَلِدْ ۙ۬","তিনি (কাউকে) জন্ম দেন"],["وَلَمۡ","and not","walam",31,"وَلَمْ","এবং নি"],["يُولَدۡ","He is begotten","yūlad",922,"یُوْلَدْ ۟ۙ","তাঁকে জন্ম দেয়া হয়"]]},{"v":4,"en":"Nor is there to Him any equivalent","bn":"এবং তার সমতুল্য কেউ নেই।","w":[["وَلَمۡ","And not","walam",31,"وَلَمْ","এবং নাই"],["يَكُن","is","yakun",9,"یَكُنْ","(হয়)"],["لَّهُۥ","for Him","lahu",10,"لَّهٗ","তাঁর"],["كُفُوًا","equivalent","kufuwan",4774,"كُفُوًا","সমতুল্য/ সমান"],["أَحَدُۢ","any [one]","aḥadun",154,"اَحَدٌ ۟۠","কেউই\""]]}]}