{"n":112,"verses":[{"v":1,"en":"Say, \"He is Allah, [who is] One","bn":"বলুন, তিনি আল্লাহ, এক","w":[["قُلۡ","Say","qul",6,"قُلْ"],["هُوَ","He","huwa",10,"هُوَ"],["ٱللَّهُ","(is) Allah","l-lahu",1,"اللّٰهُ"],["أَحَدٌ","the One","aḥadun",154,"اَحَدٌ ۟ۚ"]]},{"v":2,"en":"Allah, the Eternal Refuge","bn":"আল্লাহ অমুখাপেক্ষী","w":[["ٱللَّهُ","Allah","al-lahu",1,"اَللّٰهُ"],["ٱلصَّمَدُ","the Eternal, the Absolute","l-ṣamadu",4773,"الصَّمَدُ ۟ۚ"]]},{"v":3,"en":"He neither begets nor is born","bn":"তিনি কাউকে জন্ম দেননি এবং কেউ তাকে জন্ম দেয়নি","w":[["لَمۡ","Not","lam",31,"لَمْ"],["يَلِدۡ","He begets","yalid",922,"یَلِدْ ۙ۬"],["وَلَمۡ","and not","walam",31,"وَلَمْ"],["يُولَدۡ","He is begotten","yūlad",922,"یُوْلَدْ ۟ۙ"]]},{"v":4,"en":"Nor is there to Him any equivalent","bn":"এবং তার সমতুল্য কেউ নেই।","w":[["وَلَمۡ","And not","walam",31,"وَلَمْ"],["يَكُن","is","yakun",9,"یَكُنْ"],["لَّهُۥ","for Him","lahu",10,"لَّهٗ"],["كُفُوًا","equivalent","kufuwan",4774,"كُفُوًا"],["أَحَدُۢ","any [one]","aḥadun",154,"اَحَدٌ ۟۠"]]}]}